[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/cros_chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "read builder configs"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/HEAD/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "read builder configs.fetch HEAD:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "validate properties",
    "~followup_annotations": [
      "@@@STEP_TEXT@all properties good@@@"
    ]
  },
  {
    "name": "$result"
  }
]