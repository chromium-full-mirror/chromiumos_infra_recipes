      "@@@STEP_TEXT@config not found, assuming deleted@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set up orchestrator.configure builder.set recipes_git_revision",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@SET_BUILD_PROPERTY@recipes_git_revision@null@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set up orchestrator.configure builder.read builder configs",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "set up orchestrator.configure builder.read builder configs.fetch master:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set up orchestrator.set BISECT_BUILDER",
    "~followup_annotations": [
