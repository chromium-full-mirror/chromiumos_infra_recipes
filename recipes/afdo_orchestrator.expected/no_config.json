  },
  {
    "cmd": [
      "bb",
      "ls",
      "-host",
      "beefy-dot-cr-buildbucket.appspot.com",
      "-json",
      "-nopage",
      "-n",
      "1000",
      "-fields",
      "builder,create_time,created_by,critical,end_time,id,input,number,output,start_time,status,update_time",
      "-predicate",
      "{\"builder\": {\"project\": \"chromeos\"}, \"tags\": [{\"key\": \"parent_buildbucket_id\", \"value\": \"8945511751514863184\"}]}"
    ],
    "infra_step": true,
    "name": "set cq run cost.buildbucket.search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@"
