[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [],
    "name": "read builder configs"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/HEAD/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "luci_context": {
      "realm": {
        "name": "chromeos:postsubmit"
      },
      "resultdb": {
        "current_invocation": {
          "name": "invocations/build:8945511751514863184",
          "update_token": "token"
        },
        "hostname": "rdbhost"
      }
    },
    "name": "read builder configs.fetch HEAD:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "search the last merged uprev CL",
    "~followup_annotations": [
      "@@@STEP_SUMMARY_TEXT@Found no CL. Finishing.@@@"
    ]
  },
  {
    "cmd": [],
    "name": "search the last merged uprev CL.query https://chromium-review.googlesource.com",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_TEXT@found 0 matching CLs@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "RECIPE_REPO[depot_tools]/gerrit_client.py",
      "changes",
      "--host",
      "https://chromium-review.googlesource.com",
      "--json_file",
      "/path/to/tmp/json",
      "-p",
      "topic=chromeos-base/lacros-ash-atomic",
      "-p",
      "project=chromiumos/overlays/chromiumos-overlay",
      "-p",
      "branch=main",
      "-p",
      "status=merged",
      "-o",
      "ALL_REVISIONS",
      "--verbose"
    ],
    "env": {
      "PATH": "<PATH>:RECIPE_REPO[depot_tools]"
    },
    "infra_step": true,
    "luci_context": {
      "realm": {
        "name": "chromeos:postsubmit"
      },
      "resultdb": {
        "current_invocation": {
          "name": "invocations/build:8945511751514863184",
          "update_token": "token"
        },
        "hostname": "rdbhost"
      }
    },
    "name": "search the last merged uprev CL.query https://chromium-review.googlesource.com.gerrit changes",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@[]@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "name": "$result",
    "summaryMarkdown": "Found no CL"
  }
]