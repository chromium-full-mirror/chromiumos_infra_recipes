[
  {
    "cmd": [],
    "name": "find last 30-day Chrome uprev CLs"
  },
  {
    "cmd": [],
    "name": "find last 30-day Chrome uprev CLs.query https://chromium-review.googlesource.com",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_TEXT@found 0 matching CLs@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "RECIPE_REPO[depot_tools]/gerrit_client.py",
      "changes",
      "--host",
      "https://chromium-review.googlesource.com",
      "--json_file",
      "/path/to/tmp/json",
      "-p",
      "repo=chromiumos/overlays/chromiumos-overlay",
      "-p",
      "branch=main",
      "-p",
      "-age=30d",
      "-p",
      "-is=wip",
      "-p",
      "topic=custom-chrome",
      "-o",
      "MESSAGES",
      "-o",
      "CURRENT_REVISION",
      "-o",
      "CURRENT_FILES",
      "-o",
      "CURRENT_COMMIT",
      "--verbose"
    ],
    "env": {
      "PATH": "<PATH>:RECIPE_REPO[depot_tools]"
    },
    "infra_step": true,
    "name": "find last 30-day Chrome uprev CLs.query https://chromium-review.googlesource.com.gerrit changes",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@[]@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "find last 14-day LKGM CLs"
  },
  {
    "cmd": [],
    "name": "find last 14-day LKGM CLs.query https://chromium-review.googlesource.com",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_TEXT@found 0 matching CLs@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "RECIPE_REPO[depot_tools]/gerrit_client.py",
      "changes",
      "--host",
      "https://chromium-review.googlesource.com",
      "--json_file",
      "/path/to/tmp/json",
      "-p",
      "repo=chromium/src",
      "-p",
      "-age=14d",
      "-p",
      "-is=wip",
      "-p",
      "hashtag=chrome-lkgm",
      "-o",
      "MESSAGES",
      "-o",
      "CURRENT_REVISION",
      "-o",
      "CURRENT_COMMIT",
      "--verbose"
    ],
    "env": {
      "PATH": "<PATH>:RECIPE_REPO[depot_tools]"
    },
    "infra_step": true,
    "name": "find last 14-day LKGM CLs.query https://chromium-review.googlesource.com.gerrit changes",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@[]@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set output properties",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@chrome_uprev_commits@[]@@@",
      "@@@SET_BUILD_PROPERTY@lkgm_commits@[]@@@"
    ]
  },
  {
    "name": "$result"
  }
]