  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cp",
      "gs://chromeos-image-archive/betty-arc-r-snapshot/R88-13550.0.0-39788-8865622468216306576/image.zip",
