  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "images",
      "create",
      "betty-arc-r-8361843",
      "--source-uri=gs://images-in-test/betty-arc-r/8361843.tar.gz"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "create image.gce create image",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "create",
      "betty-arc-r-8361843",
      "--image=betty-arc-r-8361843",
      "--project=chromeos-gce-tests",
      "--machine-type=n1-standard-4",
      "--no-scopes",
      "--no-address",
      "--zone=us-central1-a",
      "--network=chromeos-gce-tests",
      "--subnet=us-central1"
