      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[recipe_engine::archive]/resources/extract.py",
      "--json-input",
      "{\"archive_file\": \"[CLEANUP]/image-archive_tmp_1/image.zip\", \"include_files\": [\"chromiumos_test_image.bin\"], \"output\": \"[CLEANUP]/image-archive_tmp_1/image\", \"safe_mode\": true}",
