  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "delete",
      "betty-arc-r-8361843",
      "--quiet",
      "--zone=us-central1-a",
      "--project=chromeos-gce-tests"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "delete instance"
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "images",
      "delete",
      "betty-arc-r-8361843",
      "--quiet"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "delete image"
  },
  {
    "name": "$result"
  }
