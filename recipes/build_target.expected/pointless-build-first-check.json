[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/cros_chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "read build config"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/generated/builder_configs.cfg",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "read build config.fetch master:generated/builder_configs.cfg",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set bisect builder",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@BISECT_BUILDER@\"amd64-generic-bisect\"@@@"
    ]
  },
  {
    "cmd": [],
    "name": "pre-sync pointless build check",
    "~followup_annotations": [
      "@@@STEP_TEXT@build is unnecessary, exiting@@@",
      "@@@STEP_LOG_LINE@relevance_output@build_is_pointless {@@@",
      "@@@STEP_LOG_LINE@relevance_output@  value: true@@@",
      "@@@STEP_LOG_LINE@relevance_output@}@@@",
      "@@@STEP_LOG_END@relevance_output@@@",
      "@@@SET_BUILD_PROPERTY@pointless_build@true@@@"
    ]
  },
  {
    "cmd": [],
    "name": "pre-sync pointless build check.ensure pointless_build_checker",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/test_planner",
      "-ensure-file",
      "chromiumos/infra/test_planner latest",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "pre-sync pointless build check.ensure pointless_build_checker.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_planner\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_planner/pointless_build_checker",
      "check-build",
      "--input_json",
      "{\"buildbucketProto\": {\"serializedProto\": \"CNDsgNmu8bWSfBIgCghjaHJvbWVvcxICY3EaEGFtZDY0LWdlbmVyaWMtY3EiHHVzZXI6Y29tbWl0LWJvdEBjaHJvbWl1bS5vcmcyBgi5wqLYBXo0GjIKIGNocm9taXVtLXJldmlldy5nb29nbGVzb3VyY2UuY29tEghjaHJvbWVvcxjAxAcgB5oBGAoPY3FfZXhwZXJpbWVudGFsEgVmYWxzZQ==\"}}",
      "--output_json",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "pre-sync pointless build check.run check",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"buildIsPointless\": true@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]