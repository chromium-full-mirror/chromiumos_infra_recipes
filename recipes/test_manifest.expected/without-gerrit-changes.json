[
  {
    "cmd": [],
    "name": "ensure synced checkout"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/chromiumos"
    ],
    "infra_step": true,
    "name": "ensure synced checkout.ensure root path",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "rmtree",
      "[CACHE]/chromiumos/.repo/manifests"
    ],
    "cwd": "[CACHE]/chromiumos",
    "infra_step": true,
    "name": "ensure synced checkout.remove .repo/manifests",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "rmtree",
      "[CACHE]/chromiumos/.repo/manifests.git"
    ],
    "cwd": "[CACHE]/chromiumos",
    "infra_step": true,
    "name": "ensure synced checkout.remove .repo/manifests.git",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "init",
      "--manifest-url",
      "https://chrome-internal.googlesource.com/chromeos/manifest-internal",
      "--reference",
      "/preload/chromeos"
    ],
    "cwd": "[CACHE]/chromiumos",
    "infra_step": true,
    "name": "ensure synced checkout.repo init",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "find",
      ".repo/",
      "-type",
      "f",
      "-name",
      "*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[CACHE]/chromiumos",
    "infra_step": true,
    "name": "ensure synced checkout.clear repo locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "-c",
      "find",
      ".git/",
      "-type",
      "f",
      "-name",
      "*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[CACHE]/chromiumos",
    "infra_step": true,
    "name": "ensure synced checkout.clear git locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "sync",
      "--force-sync",
      "--detach",
      "--current-branch",
      "--jobs",
      "32",
      "--no-tags",
      "--optimized-fetch"
    ],
    "cwd": "[CACHE]/chromiumos",
    "infra_step": true,
    "name": "ensure synced checkout.repo sync",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "mount overlay master"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
