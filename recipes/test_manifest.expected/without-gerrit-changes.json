      "--mode",
      "0777",
      "[CLEANUP]/overlayfs/upperdir"
    ],
    "infra_step": true,
    "name": "mount overlay master.create upperdir",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
