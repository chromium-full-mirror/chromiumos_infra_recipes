    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "ensure synced checkout.remove .repo/manifests.git",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
