      "--manifest-url",
      "https://chrome-internal.googlesource.com/chromeos/manifest-internal",
      "--groups",
      "all",
      "--groups",
      "partner-config,testprogram-testproject"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "ensure synced checkout.repo init",
