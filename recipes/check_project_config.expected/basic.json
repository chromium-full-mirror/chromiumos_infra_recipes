      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "find",
      ".repo/",
      "-type",
      "f",
      "-name",
      "*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "ensure synced checkout.clear repo locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--ignore-missing",
      "-j",
      "32",
      "-c",
      "find",
      ".git/",
      "-type",
      "f",
      "-name",
      "*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "ensure synced checkout.clear git locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "ensure synced checkout.ensure clean checkout",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--ignore-missing",
      "-j",
      "32",
      "-c",
      "git",
      "clean",
      "-d",
      "-f"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "ensure synced checkout.ensure clean checkout.repo forall",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "ensure synced checkout.repo binary update",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "selfupdate"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "ensure synced checkout.repo binary update.repo selfupdate",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "sync",
      "--force-sync",
      "--detach",
      "--current-branch",
      "--jobs",
      "32",
      "--no-tags",
      "--optimized-fetch"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "ensure synced checkout.repo sync",
    "timeout": 3600,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "sync to snapshot"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https:/+//snapshot.xml",
      "--format",
      "text"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "name": "sync to snapshot.fetch :snapshot.xml",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "<manifest></manifest>",
      "[CLEANUP]/manifest_tmp_1"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "sync to snapshot.write manifest",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@manifest_tmp_1@<manifest></manifest>@@@",
      "@@@STEP_LOG_END@manifest_tmp_1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "sync",
      "--detach",
      "--manifest-name",
      "../../../../[CLEANUP]/manifest_tmp_1",
      "--optimized-fetch"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "sync to snapshot.repo sync",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "repo forall",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@raw_io.output@chromiumos/config|src/config|cros|refs/heads/master@@@",
      "@@@STEP_LOG_LINE@raw_io.output@chromeos/program/testprogram|src/program/testprogram|cros|refs/heads/master@@@",
      "@@@STEP_LOG_LINE@raw_io.output@chromeos/project/testproject|src/project/testproject|cros|refs/heads/master@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
