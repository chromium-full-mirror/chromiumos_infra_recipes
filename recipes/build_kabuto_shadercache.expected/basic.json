[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [],
    "name": "validate properties",
    "~followup_annotations": [
      "@@@STEP_TEXT@all properties good@@@"
    ]
  },
  {
    "cmd": [
      "docker",
      "help"
    ],
    "name": "check docker install"
  },
  {
    "cmd": [],
    "name": "clone kabuto"
  },
  {
    "cmd": [
      "git",
      "clone",
      "https://chrome-internal.googlesource.com/chromeos/platform/borealis-private",
      "."
    ],
    "cwd": "[CLEANUP]/borealis_tmp_1",
    "infra_step": true,
    "name": "clone kabuto.git clone",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "fetch kabuto payload"
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cp",
      "gs://kabuto_cache/test-recipe-payloads/kabuto_volteer.tar.gz",
      "kabuto_payload.tar.gz"
    ],
    "cwd": "[CLEANUP]/borealis_tmp_1",
    "infra_step": true,
    "name": "fetch kabuto payload.gsutil download",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "tar",
      "xvf",
      "kabuto_payload.tar.gz",
      "-C",
      "tools/kabuto/in/"
    ],
    "cwd": "[CLEANUP]/borealis_tmp_1",
    "name": "fetch kabuto payload.untar kabuto payload",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "./tools/kabuto/kabuto",
      "--gcs",
      "--no-interactive"
    ],
    "cwd": "[CLEANUP]/borealis_tmp_1",
    "name": "run kabuto"
  },
  {
    "cmd": [],
    "name": "upload kabuto logs"
  },
  {
    "cmd": [
      "tar",
      "cvf",
      "kabuto_logs_2012-05-14-125323.tar",
      "tools/kabuto/logs/"
    ],
    "cwd": "[CLEANUP]/borealis_tmp_1",
    "name": "upload kabuto logs.bundle kabuto logs",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cp",
      "kabuto_logs_2012-05-14-125323.tar",
      "gs://kabuto_cache/test-recipe-payloads/logs/kabuto_logs_2012-05-14-125323.tar"
    ],
    "cwd": "[CLEANUP]/borealis_tmp_1",
    "infra_step": true,
    "name": "upload kabuto logs.gsutil upload",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LINK@gsutil.upload@https://storage.cloud.google.com/kabuto_cache/test-recipe-payloads/logs/kabuto_logs_2012-05-14-125323.tar@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/borealis_tmp_1/tools/kabuto/out/updated_artifacts.json",
      "/path/to/tmp/"
    ],
    "cwd": "[CLEANUP]/borealis_tmp_1",
    "infra_step": true,
    "name": "Read updated_artifacts.json",
    "~followup_annotations": [
      "@@@STEP_LOG_END@updated_artifacts.json@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set uprev_info",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@uprev_info@\"\"@@@"
    ]
  },
  {
    "name": "$result"
  }
]