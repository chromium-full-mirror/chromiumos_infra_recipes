    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "query swarming.querying atlas.git clean",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "[CLEANUP]/swarming-client/swarming.py",
      "query",
      "--swarming",
      "chromeos-swarming.appspot.com",
      "bots/count?dimensions=label-board:atlas"
    ],
    "infra_step": true,
    "name": "query swarming.querying atlas.get bot query result",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[CLEANUP]/swarming-client/swarming.py",
      "query",
      "--swarming",
      "chromeos-swarming.appspot.com",
      "tasks/count?state=RUNNING&tags=label-board:atlas&start=1336913601.5"
    ],
    "infra_step": true,
    "name": "query swarming.querying atlas.get task query result",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[CLEANUP]/swarming-client/swarming.py",
      "query",
      "--swarming",
      "chromeos-swarming.appspot.com",
      "tasks/count?state=PENDING&tags=label-board:atlas&start=1336913603.0"
    ],
    "infra_step": true,
    "name": "query swarming.querying atlas.get task query result (2)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
