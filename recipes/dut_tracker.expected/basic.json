[
  {
    "cmd": [],
    "name": "ensure swarming bin from CIPD"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd",
      "-ensure-file",
      "infra/tools/luci/swarming/${platform} latest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure swarming bin from CIPD.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra/tools/luci/swarming/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get config"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/HEAD/testingconfig/generated/dut_tracking.binaryproto",
      "--format",
      "text"
    ],
    "name": "get config.fetch HEAD:testingconfig/generated/dut_tracking.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "query swarming"
  },
  {
    "cmd": [],
    "name": "query swarming.querying atlas",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "bots",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-dimension",
      "label-board=atlas"
    ],
    "infra_step": true,
    "name": "query swarming.querying atlas.get bot count query result",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-start",
      "1336913601.5",
      "-state",
      "RUNNING",
      "-tag",
      "label-board:atlas"
    ],
    "infra_step": true,
    "name": "query swarming.querying atlas.get task count query result",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-start",
      "1336913603.0",
      "-state",
      "PENDING",
      "-tag",
      "label-board:atlas"
    ],
    "infra_step": true,
    "name": "query swarming.querying atlas.get task count query result (2)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-start",
      "1336913604.5",
      "-state",
      "PENDING",
      "-tag",
      "label-board:atlas",
      "-limit",
      "1000"
    ],
    "infra_step": true,
    "name": "query swarming.querying atlas.get task list query result",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@[@@@",
      "@@@STEP_LOG_LINE@json.output@  {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"created_ts\": \"2012-05-14T11:53:26.000000Z\"@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"created_ts\": \"2012-05-14T10:53:26.000000Z\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@]@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "query swarming.set properties",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@SET_BUILD_PROPERTY@bot_stats@[{\"name\": \"atlas\"}]@@@",
      "@@@SET_BUILD_PROPERTY@pend_stats@[{\"name\": \"atlas\", \"pend\": 2.000277777777778}]@@@",
      "@@@SET_BUILD_PROPERTY@task_stats@[{\"PENDING\": {}, \"RUNNING\": {}, \"name\": \"atlas\"}]@@@"
    ]
  },
  {
    "name": "$result"
  }
]