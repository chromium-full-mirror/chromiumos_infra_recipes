[
  {
    "cmd": [],
    "name": "get config"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/testingconfig/generated/dut_tracking.binaryproto",
      "--format",
      "text"
    ],
    "name": "get config.fetch master:testingconfig/generated/dut_tracking.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "query swarming"
  },
  {
    "cmd": [],
    "name": "query swarming.querying atlas",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::git]/resources/git_setup.py",
      "--path",
      "[CLEANUP]/swarming-client",
      "--url",
      "https://chromium.googlesource.com/infra/luci/client-py"
    ],
    "infra_step": true,
    "name": "query swarming.querying atlas.git setup",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "fetch",
      "origin",
      "master",
      "--progress"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "env": {
      "PATH": "RECIPE_REPO[depot_tools]:<PATH>"
    },
    "infra_step": true,
    "name": "query swarming.querying atlas.git fetch",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "checkout",
      "-f",
      "FETCH_HEAD"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "query swarming.querying atlas.git checkout",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "rev-parse",
      "HEAD"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "query swarming.querying atlas.read revision",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_TEXT@<br/>checked out 'deadbeef'<br/>@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "clean",
      "-f",
      "-d",
      "-x"
