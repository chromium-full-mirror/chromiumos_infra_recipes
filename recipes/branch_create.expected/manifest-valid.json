[
  {
    "cmd": [],
    "name": "fetch manifest"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chromium.googlesource.com/manifest/internal/+/refs/head/master/foo.xml",
      "--format",
      "text"
    ],
    "name": "fetch manifest.fetch refs/head/master:foo.xml",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "foo",
      "[CLEANUP]/manifests-_tmp_1/downloaded.xml"
    ],
    "infra_step": true,
    "name": "fetch manifest.write manifest to file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@downloaded.xml@foo@@@",
      "@@@STEP_LOG_END@downloaded.xml@@@"
    ]
  },
  {
    "cmd": [],
    "name": "ensure branch_util"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/test_planner",
      "-ensure-file",
      "chromiumos/infra/test_planner test_manifest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure branch_util.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-test_manifest---\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_planner\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_planner/branch_util",
      "create",
      "--file",
      "[CLEANUP]/manifests-_tmp_1/downloaded.xml",
      "--custom",
      "my_custom_branch",
      "--descriptor",
      "nami",
      "--force",
      "--push",
      "-j",
      "8"
    ],
    "name": "create branch"
  },
  {
    "name": "$result"
  }
]