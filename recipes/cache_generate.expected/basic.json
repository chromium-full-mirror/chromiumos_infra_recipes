[
  {
    "cmd": [],
    "name": "repo checkout"
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "init",
      "--manifest-url",
      "https://chrome-internal.googlesource.com/chromeos/manifest-internal",
      "--groups",
      "all"
    ],
    "infra_step": true,
    "name": "repo checkout.repo init",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "find",
      ".repo/",
      "-type",
      "f",
      "-name",
      "*.lock",
      "-print",
      "-delete"
    ],
    "infra_step": true,
    "name": "repo checkout.clear repo locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--ignore-missing",
      "-j",
      "32",
      "-c",
      "find",
      ".git/",
      "-type",
      "f",
      "-name",
      "*.lock",
      "-print",
      "-delete"
    ],
    "infra_step": true,
    "name": "repo checkout.clear git locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "sync",
      "--jobs",
      "32"
    ],
    "infra_step": true,
    "name": "repo checkout.repo sync",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]