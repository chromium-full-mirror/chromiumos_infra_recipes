[
  {
    "cmd": [],
    "name": "read builder configs"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/HEAD/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "read builder configs.fetch HEAD:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "query for cq-orchestrators",
    "~followup_annotations": [
      "@@@STEP_TEXT@found 1 builds@@@",
      "@@@STEP_LINK@1112@https://cr-buildbucket.appspot.com/build/1112@@@"
    ]
  },
  {
    "cmd": [
      "bb",
      "ls",
      "-host",
      "cr-buildbucket.appspot.com",
      "-json",
      "-nopage",
      "-n",
      "1000",
      "-fields",
      "builder,create_time,created_by,critical,end_time,id,infra,input,number,output,start_time,status,tags,update_time",
      "-predicate",
      "{\"builder\": {\"bucket\": \"cq\", \"builder\": \"cq-orchestrator\", \"project\": \"chromeos\"}, \"createTime\": {\"startTime\": \"1969-12-31T00:00:00Z\"}}"
    ],
    "infra_step": true,
    "name": "query for cq-orchestrators.buildbucket.search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@raw_io.output_text@{\"builder\": {\"bucket\": \"cq\", \"builder\": \"cq-orchestrator\", \"project\": \"chromeos\"}, \"createTime\": \"1970-01-01T00:18:31Z\", \"createdBy\": \"project:chromeos\", \"id\": \"1111\", \"infra\": {\"resultdb\": {\"invocation\": \"invocations/build:1111\"}, \"swarming\": {\"botDimensions\": [{\"key\": \"bot_size\", \"value\": \"small\"}], \"priority\": 30}}, \"input\": {\"gerritChanges\": [{\"change\": \"123456\", \"host\": \"chromium-review.googlesource.com\", \"patchset\": \"7\", \"project\": \"project-a\"}]}, \"status\": \"FAILURE\", \"tags\": [{\"key\": \"cq_experimental\", \"value\": \"false\"}]}@@@",
      "@@@STEP_LOG_LINE@raw_io.output_text@{\"builder\": {\"bucket\": \"cq\", \"builder\": \"cq-orchestrator\", \"project\": \"chromeos\"}, \"createTime\": \"1970-01-01T00:18:32Z\", \"createdBy\": \"project:chromeos\", \"id\": \"1112\", \"infra\": {\"resultdb\": {\"invocation\": \"invocations/build:1112\"}, \"swarming\": {\"botDimensions\": [{\"key\": \"bot_size\", \"value\": \"small\"}], \"priority\": 30}}, \"input\": {\"gerritChanges\": [{\"change\": \"123456\", \"host\": \"chromium-review.googlesource.com\", \"patchset\": \"7\", \"project\": \"project-a\"}]}, \"status\": \"FAILURE\", \"tags\": [{\"key\": \"cq_experimental\", \"value\": \"false\"}]}@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@",
      "@@@STEP_LINK@1111@https://cr-buildbucket.appspot.com/build/1111@@@",
      "@@@STEP_LINK@1112@https://cr-buildbucket.appspot.com/build/1112@@@"
    ]
  },
  {
    "cmd": [],
    "name": "analyzing candidates"
  },
  {
    "cmd": [],
    "name": "analyzing candidates.analyzing 1112",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LINK@build link@https://cr-buildbucket.appspot.com/build/1112@@@"
    ]
  },
  {
    "cmd": [],
    "name": "analyzing candidates.analyzing 1112.analyzing build results",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_TEXT@0 success, 0 retryable, 0 outstanding@@@",
      "@@@STEP_LOG_END@successful_builders@@@",
      "@@@STEP_LOG_END@retryable_failure_builders@@@",
      "@@@STEP_LOG_END@outstanding_failure_builders@@@"
    ]
  },
  {
    "cmd": [],
    "name": "analyzing candidates.analyzing 1112.analyzing test results",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_TEXT@0 success, 0 retryable, 0 outstanding@@@",
      "@@@STEP_LOG_END@successful_test_suite_names@@@",
      "@@@STEP_LOG_END@retryable_test_suite_names@@@",
      "@@@STEP_LOG_END@outstanding_failure_test_suite_names@@@"
    ]
  },
  {
    "cmd": [],
    "name": "analyzing candidates.analyzing 1112.exoneration analysis",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_TEXT@skipping: no test variant failures@@@"
    ]
  },
  {
    "name": "$result"
  }
