[
  {
    "cmd": [],
    "name": "extracting Chrome version",
    "~followup_annotations": [
      "@@@STEP_SUMMARY_TEXT@Chrome version: 98.0.1234.1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "Fetch ToT version",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@data@MAJOR=98@@@",
      "@@@STEP_LOG_LINE@data@MINOR=0@@@",
      "@@@STEP_LOG_LINE@data@BUILD=1234@@@",
      "@@@STEP_LOG_LINE@data@PATCH=0@@@",
      "@@@STEP_LOG_END@data@@@"
    ]
  },
  {
    "cmd": [
      "curl",
      "-f",
      "--write-out",
      "HTTP_CODE=%{http_code}",
      "-b",
      "[HOME]/.git-credential-cache/cookie",
      "--retry",
      "3",
      "https://chromium.googlesource.com/a/chromium/src/+/refs/heads/main/chrome/VERSION?format=TEXT"
    ],
    "luci_context": {
      "realm": {
        "name": "chromeos:infra"
      },
      "resultdb": {
        "current_invocation": {
          "update_token": "token"
        },
        "hostname": "rdbhost"
      }
    },
    "name": "Fetch ToT version.curl https://chromium.googlesource.com/a/chromium/src/+/refs/heads/main/chrome/VERSION?format=TEXT",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "trigger puprs"
  },
  {
    "name": "$result",
    "summaryMarkdown": "No uprev on non-release branch release (daily canary)"
  }
]