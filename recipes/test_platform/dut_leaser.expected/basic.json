[
  {
    "cmd": [],
    "name": "validate crosfleet tool version"
  },
  {
    "cmd": [],
    "name": "lease DUT for 2 hr 3 min"
  },
  {
    "cmd": [],
    "name": "lease DUT for 2 hr 3 min.update DUT state to needs_repair",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "lease DUT for 2 hr 3 min.update DUT state to needs_repair.call `phosphorus`",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@request@{\"config\":{\"adminService\":\"foo-service\",\"autotestDir\":\"/path/to/autotest\",\"crosInventoryService\":\"inv-service\",\"crosUfsService\":\"ufs-service\"},\"dutId\":\"dummy-dut-id\",\"dutName\":\"dummy\",\"runId\":\"dummy-task-id\",\"testId\":\"dut-leaser\"}@@@",
      "@@@STEP_LOG_END@request@@@",
      "@@@STEP_LOG_LINE@response@{@@@",
      "@@@STEP_LOG_LINE@response@  \"dutTopology\": [@@@",
      "@@@STEP_LOG_LINE@response@    {@@@",
      "@@@STEP_LOG_LINE@response@      \"hostname\": \"dummy-hostname\"@@@",
      "@@@STEP_LOG_LINE@response@    }@@@",
      "@@@STEP_LOG_LINE@response@  ], @@@",
      "@@@STEP_LOG_LINE@response@  \"resultsDir\": \"dummy-results-dir\"@@@",
      "@@@STEP_LOG_LINE@response@}@@@",
      "@@@STEP_LOG_END@response@@@"
    ]
  },
  {
    "cmd": [],
    "name": "lease DUT for 2 hr 3 min.update DUT state to needs_repair.call `phosphorus`.ensure phosphorus",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/phosphorus",
      "-ensure-file",
      "chromiumos/infra/phosphorus/${platform} phosphorus_prod",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "lease DUT for 2 hr 3 min.update DUT state to needs_repair.call `phosphorus`.ensure phosphorus.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@4@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-phosphorus_prod-\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/phosphorus/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/phosphorus/phosphorus",
      "load",
      "-input_json",
      "/dev/stdin",
      "-output_json",
      "/dev/stdout"
    ],
    "infra_step": true,
    "name": "lease DUT for 2 hr 3 min.update DUT state to needs_repair.call `phosphorus`.load",
    "stdin": "{\"config\":{\"adminService\":\"foo-service\",\"autotestDir\":\"/path/to/autotest\",\"crosInventoryService\":\"inv-service\",\"crosUfsService\":\"ufs-service\"},\"dutId\":\"dummy-dut-id\",\"dutName\":\"dummy\",\"runId\":\"dummy-task-id\",\"testId\":\"dut-leaser\"}",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [],
    "name": "lease DUT for 2 hr 3 min.update DUT state to needs_repair.call `phosphorus` (2)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@request@{\"config\":{\"adminService\":\"foo-service\",\"autotestDir\":\"/path/to/autotest\",\"crosInventoryService\":\"inv-service\",\"crosUfsService\":\"ufs-service\"},\"dutId\":\"dummy-dut-id\",\"dutName\":\"dummy-hostname\",\"dutState\":\"needs_repair\",\"resultsDir\":\"dummy-results-dir\",\"sealResultsDir\":true}@@@",
      "@@@STEP_LOG_END@request@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/phosphorus/phosphorus",
      "save",
      "-input_json",
      "/dev/stdin"
    ],
    "infra_step": true,
    "name": "lease DUT for 2 hr 3 min.update DUT state to needs_repair.call `phosphorus` (2).save",
    "stdin": "{\"config\":{\"adminService\":\"foo-service\",\"autotestDir\":\"/path/to/autotest\",\"crosInventoryService\":\"inv-service\",\"crosUfsService\":\"ufs-service\"},\"dutId\":\"dummy-dut-id\",\"dutName\":\"dummy-hostname\",\"dutState\":\"needs_repair\",\"resultsDir\":\"dummy-results-dir\",\"sealResultsDir\":true}",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [],
    "name": "lease DUT for 2 hr 3 min.sleep for remainder of lease",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "lease DUT for 2 hr 3 min.sleep for remainder of lease.sleep 7378",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "name": "$result"
  }
]