[
  {
    "cmd": [],
    "name": "process CTP builds"
  },
  {
    "cmd": [],
    "name": "process CTP builds.call `result_flow`",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@request@{\"ctp\":{\"bb\":{\"bucket\":\"testplatform\",\"builder\":\"cros_test_platform\",\"host\":\"cr-buildbucket.appspot.com\",\"project\":\"chromeos\"},\"fields\":[\"id\",\"status\",\"input.properties\",\"output.properties\",\"create_time\",\"start_time\",\"end_time\"],\"pubsub\":{\"maxReceivingMessages\":50,\"project\":\"foo-project\",\"subscription\":\"foo-subscription\",\"topic\":\"foo-topic\"}},\"testPlanRun\":{\"bq\":{\"dataset\":\"foo-dataset\",\"project\":\"foo-project\",\"table\":\"foo-table\"}}}@@@",
      "@@@STEP_LOG_END@request@@@",
      "@@@STEP_LOG_LINE@response@{@@@",
      "@@@STEP_LOG_LINE@response@  \"state\": \"SUCCEEDED\"@@@",
      "@@@STEP_LOG_LINE@response@}@@@",
      "@@@STEP_LOG_END@response@@@"
    ]
  },
  {
    "cmd": [],
    "name": "process CTP builds.call `result_flow`.ensure result_flow",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/result_flow",
      "-ensure-file",
      "chromiumos/infra/result_flow/${platform} latest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "process CTP builds.call `result_flow`.ensure result_flow.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/result_flow/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/result_flow/result_flow",
      "pipe-ctp-data",
      "-input_json",
      "/dev/stdin",
      "-output_json",
      "/dev/stdout"
    ],
    "name": "process CTP builds.call `result_flow`.pipe-ctp-data",
    "stdin": "{\"ctp\":{\"bb\":{\"bucket\":\"testplatform\",\"builder\":\"cros_test_platform\",\"host\":\"cr-buildbucket.appspot.com\",\"project\":\"chromeos\"},\"fields\":[\"id\",\"status\",\"input.properties\",\"output.properties\",\"create_time\",\"start_time\",\"end_time\"],\"pubsub\":{\"maxReceivingMessages\":50,\"project\":\"foo-project\",\"subscription\":\"foo-subscription\",\"topic\":\"foo-topic\"}},\"testPlanRun\":{\"bq\":{\"dataset\":\"foo-dataset\",\"project\":\"foo-project\",\"table\":\"foo-table\"}}}",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "name": "$result"
  }
]