[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/cros_chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "validate properties",
    "~followup_annotations": [
      "@@@STEP_TEXT@all properties good@@@"
    ]
  },
  {
    "cmd": [],
    "name": "validate triggers",
    "~followup_annotations": [
      "@@@STEP_EXCEPTION@@@"
    ]
  },
  {
    "cmd": [],
    "name": "RECIPE CRASH (Uncaught exception)",
    "~followup_annotations": [
      "@@@STEP_EXCEPTION@@@",
      "The recipe has crashed at point 'Uncaught exception'!",
      "",
      "Traceback (most recent call last):",
      "  File \"RECIPE_REPO[recipe_engine]/recipe_engine/internal/engine.py\", in run_steps",
      "    raw_result = recipe_obj.run_steps(api, engine)",
      "  File \"RECIPE_REPO[recipe_engine]/recipe_engine/internal/recipe_deps.py\", in run_steps",
      "    recipe_result = self.global_symbols['RunSteps'](*args)",
      "  File \"RECIPE_REPO[chromeos]/recipes/generator.py\", line 77, in RunSteps",
      "    raise ValueError('found non-gitiles trigger: %r', trigger)",
      "ValueError: ('found non-gitiles trigger: %r', id: \"456\"",
      "webui {",
      "}",
      ")"
    ]
  },
  {
    "failure": {
      "humanReason": "Uncaught Exception: ValueError('found non-gitiles trigger: %r', id: \"456\"\nwebui {\n}\n)"
    },
    "name": "$result"
  }
]