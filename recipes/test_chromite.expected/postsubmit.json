[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/cros_chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder",
    "~followup_annotations": [
      "@@@STEP_TEXT@config not found, assuming deleted@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.set recipes_git_revision",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@SET_BUILD_PROPERTY@recipes_git_revision@null@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.read builder configs",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "configure builder.read builder configs.fetch master:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gitiles_commit",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gitiles_commit.set gitiles_commit",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@SET_BUILD_PROPERTY@commit@{\"host\": \"chromium.googlesource.com\", \"id\": \"2d72510e447ab60a9728aeea2362d8be2cbd7789\", \"project\": \"project-a\", \"ref\": \"refs/heads/master\"}@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.build_manifest",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gerrit_changes",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gerrit_changes.set gerrit_changes",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@SET_BUILD_PROPERTY@changes@\"[]\"@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set build cost",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@build_cost@0.0002@@@"
    ]
  },
  {
    "failure": {
      "failure": {},
      "humanReason": "Missing configuration for chromite-postsubmit"
    },
    "name": "$result"
  }
]