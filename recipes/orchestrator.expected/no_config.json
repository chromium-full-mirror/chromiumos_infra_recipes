      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "set up orchestrator.configure builder.read builder configs.fetch master:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
