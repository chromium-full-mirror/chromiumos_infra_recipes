[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/cros_chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "check for merge conflicts",
    "~followup_annotations": [
      "@@@STEP_TEXT@unable to cherry-pick changes@@@",
      "@@@STEP_LOG_LINE@cherry-pick-failures@some cherry pick error@@@",
      "@@@STEP_LOG_END@cherry-pick-failures@@@",
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "\nimport shutil\nimport sys\nshutil.copy(sys.argv[1], sys.argv[2])\n",
      "RECIPE_REPO[chromeos]/support/deploy_cipd.json",
      "/path/to/tmp/json"
    ],
    "name": "check for merge conflicts.read deploy_cipd.json",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"instance_id\": \"inst\", @@@",
      "@@@STEP_LOG_LINE@json.output@    \"package\": \"pkg\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cros-recipes-support",
      "-ensure-file",
      "pkg inst",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "name": "check for merge conflicts.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-inst------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"pkg\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cros-recipes-support/git-test-submit/git-test-submit"
    ],
    "infra_step": true,
    "name": "check for merge conflicts.git-test-submit",
    "stdin": "{\"gerrit_changes\": [{\"change_number\": 1234, \"host\": \"\", \"patch_set\": 0}], \"temp_dir\": \"[CLEANUP]/submittable_check\"}",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"errors\": [@@@",
      "@@@STEP_LOG_LINE@json.output@    \"some cherry pick error\"@@@",
      "@@@STEP_LOG_LINE@json.output@  ]@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "failure": {
      "failure": {},
      "humanReason": "failed to cherry-pick changes, please rebase and retry"
    },
    "name": "$result"
  }
]