[
  {
    "cmd": [],
    "name": "ensure manifest_doctor"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd",
      "-ensure-file",
      "chromiumos/infra/manifest_doctor/${platform} prod",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure manifest_doctor.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/manifest_doctor/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "create program/project buildspec(s)"
  },
  {
    "cmd": [
      "[START_DIR]/cipd/manifest_doctor",
      "project-buildspec",
      "--buildspec",
      "buildspecs/foo/1.2.3.xml",
      "--projects",
      "galaxy/milkyway,foo/*",
      "--push"
    ],
    "name": "create program/project buildspec(s).run manifest_doctor",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set build cost",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@build_cost@0.0@@@"
    ]
  },
  {
    "name": "$result"
  }
]