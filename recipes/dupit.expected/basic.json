    "infra_step": true,
    "name": "gsutil Download distfiles from gs://chromeos-mirror/gentoo/latest_distfiles/"
  },
  {
    "cmd": [
      "rsync",
      "--recursive",
      "--links",
      "--safe-links",
      "--delete",
      "--perms",
      "--times",
      "--compress",
      "--stats",
      "--progress",
      "--human-readable",
      "--timeout=180",
      "--bwlimit=1m",
      "rsync://mirrors.rit.edu/gentoo/distfiles",
      "[CACHE]/gentoo_distfiles"
    ],
    "infra_step": true,
    "name": "Sync distfiles from rsync://mirrors.rit.edu/gentoo/distfiles"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "-o",
      "GSUtil:parallel_composite_upload_threshold=50M",
      "-m",
      "----",
      "cp",
      "-r",
      "-n",
      "-p",
      "[CACHE]/gentoo_distfiles/distfiles/*",
      "gs://chromeos-mirror/gentoo/distfiles/"
    ],
    "infra_step": true,
    "name": "gsutil Upload new distfiles to gs://chromeos-mirror/gentoo/distfiles/"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "-o",
      "GSUtil:parallel_composite_upload_threshold=50M",
      "-m",
      "----",
      "rsync",
      "-r",
      "-d",
      "[CACHE]/gentoo_distfiles",
      "gs://chromeos-mirror/gentoo/latest_distfiles/"
    ],
    "infra_step": true,
    "name": "gsutil Sync latest distfiles to gs://chromeos-mirror/gentoo/latest_distfiles/"
