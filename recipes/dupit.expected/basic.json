[
  {
    "cmd": [
      "rsync",
      "--recursive",
      "--links",
      "--safe-links",
      "--perms",
      "--times",
      "--compress",
      "--stats",
      "--progress",
      "--human-readable",
      "--timeout=180",
      "--bwlimit=10m",
      "rsync://mirrors.rit.edu/gentoo/distfiles",
      "[CACHE]/gentoo_distfiles"
    ],
    "name": "Sync distfiles from rsync://mirrors.rit.edu/gentoo/distfiles"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "-o",
      "GSUtil:parallel_composite_upload_threshold=50M",
      "-m",
      "----",
      "rsync",
      "-r",
      "-n",
      "[CACHE]/gentoo_distfiles",
      "gs://chromeos-mirror/gentoo/distfiles/"
    ],
    "infra_step": true,
    "name": "gsutil Upload distfiles to gs://chromeos-mirror/gentoo/distfiles/"
  },
  {
    "jsonResult": null,
    "name": "$result"
  }
]