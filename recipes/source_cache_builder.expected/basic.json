[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "/preload/chromeos-sdk"
    ],
    "infra_step": true,
    "name": "configure chroot path.create preload path",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache update"
  },
  {
    "cmd": [],
    "name": "source cache update.cleanup expired snapshots",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache update.cleanup expired snapshots.set expired_snapshots",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@SET_BUILD_PROPERTY@expired_snapshots@[]@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache update.cleanup expired images",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache update.cleanup expired images.set expired_images",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@SET_BUILD_PROPERTY@expired_images@[]@@@"
    ]
  },
  {
    "name": "$result"
  }
]