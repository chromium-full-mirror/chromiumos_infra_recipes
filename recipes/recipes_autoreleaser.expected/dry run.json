[
  {
    "cmd": [
      "git",
      "clone",
      "https://chromium.googlesource.com/chromiumos/infra/recipes",
      ".",
      "-v",
      "--progress"
    ],
    "cwd": "[CLEANUP]/autorelease_tmp_1",
    "infra_step": true,
    "name": "git clone"
  },
  {
    "cmd": [],
    "name": "release bundle 'infra' (dry-run)"
  },
  {
    "cmd": [
      "[CLEANUP]/autorelease_tmp_1/release.sh",
      "--max-releasable",
      "--verbose",
      "--show-instances",
      "--bundle",
      "infra",
      "--yes",
      "--dry-run",
      "--result-out",
      "[CLEANUP]/result_jsonpb_tmp_1"
    ],
    "cwd": "[CLEANUP]/autorelease_tmp_1",
    "infra_step": true,
    "name": "release bundle 'infra' (dry-run).run release.sh",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/result_jsonpb_tmp_1",
      "/path/to/tmp/"
    ],
    "cwd": "[CLEANUP]/autorelease_tmp_1",
    "infra_step": true,
    "name": "release bundle 'infra' (dry-run).read result jsonproto",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@{@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@  \"announcementEmail\": {@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@    \"subject\": \"We released infra\",@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@    \"body\": \"Released commits 1, 2, and 3\"@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@  },@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@  \"releasedCommits\": [@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@    {@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@      \"hash\": \"123\",@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@      \"author\": \"user1\",@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@      \"subject\": \"Commit 1\"@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@    },@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@    {@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@      \"hash\": \"456\",@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@      \"author\": \"user2\",@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@      \"subject\": \"Commit 2\"@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@    }@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@  ]@@@",
      "@@@STEP_LOG_LINE@result_jsonpb_tmp_1@}@@@",
      "@@@STEP_LOG_END@result_jsonpb_tmp_1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "release bundle 'infra' (dry-run).set output properties",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@SET_BUILD_PROPERTY@body@\"Released commits 1, 2, and 3\"@@@",
      "@@@SET_BUILD_PROPERTY@released_commits@[{\"author\": \"user1\", \"hash\": \"123\", \"subject\": \"Commit 1\"}, {\"author\": \"user2\", \"hash\": \"456\", \"subject\": \"Commit 2\"}]@@@",
      "@@@SET_BUILD_PROPERTY@subject@\"We released infra\"@@@"
    ]
  },
  {
    "name": "$result",
    "summaryMarkdown": "\n[DRY RUN]Released commits:\n\n- 123 [user1] Commit 1\n- 456 [user2] Commit 2\n"
  }
]