[
  {
    "cmd": [],
    "name": "set up"
  },
  {
    "cmd": [
      "git",
      "clone",
      "https://chrome-internal.googlesource.com/chromeos/infra/config",
      "[CLEANUP]/tmp_tmp_1"
    ],
    "infra_step": true,
    "name": "set up.git clone",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "generate binary config"
  },
  {
    "cmd": [],
    "name": "generate binary config.copy remote configs",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cp",
      "gs:///build_config.ToT.json",
      "[CLEANUP]/tmp_tmp_1/goldeneye/build_config.ToT.json"
    ],
    "infra_step": true,
    "name": "generate binary config.copy remote configs.gsutil download /build_config.ToT.json",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[CLEANUP]/tmp_tmp_2",
      "-ensure-file",
      "infra/tools/protoc/linux-amd64 protobuf_version:v3.11.4",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "generate binary config.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-protobuf_version\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra/tools/protoc/linux-amd64\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "/bin/bash",
      "regenerate_configs.sh",
      "-b"
    ],
    "cwd": "[CLEANUP]/tmp_tmp_1",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]",
        "[CLEANUP]/tmp_tmp_2"
      ]
    },
    "name": "generate binary config.regenerate configs",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "commit changes",
    "~followup_annotations": [
      "@@@STEP_TEXT@not configured to commit changes@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "status",
      "--porcelain"
    ],
    "cwd": "[CLEANUP]/tmp_tmp_1",
    "infra_step": true,
    "name": "commit changes.git status",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]