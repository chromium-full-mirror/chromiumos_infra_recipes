[
  {
    "cmd": [],
    "name": "set up"
  },
  {
    "cmd": [
      "git",
      "clone",
      "https://chrome-internal.googlesource.com/chromeos/infra/config",
      "[CLEANUP]/tmp_tmp_1"
    ],
    "infra_step": true,
    "name": "set up.git clone",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "generate binary config"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[CLEANUP]/tmp_tmp_2",
      "-ensure-file",
      "infra/tools/protoc/linux-amd64 protobuf_version:v3.11.4",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "env_suffixes": {
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "generate binary config.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-protobuf_version\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra/tools/protoc/linux-amd64\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "/bin/bash",
      "[CLEANUP]/tmp_tmp_1/regenerate_configs.sh",
      "-b"
    ],
    "env_suffixes": {
      "PATH": [
        "RECIPE_REPO[depot_tools]",
        "[CLEANUP]/tmp_tmp_2"
      ]
    },
    "name": "generate binary config.regenerate configs",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "commit changes"
  },
  {
    "cmd": [
      "git",
      "status",
      "--porcelain"
    ],
    "cwd": "[CLEANUP]/tmp_tmp_1",
    "infra_step": true,
    "name": "commit changes.git status",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "add",
      "changed.txt",
      "new.txt"
    ],
    "cwd": "[CLEANUP]/tmp_tmp_1",
    "infra_step": true,
    "name": "commit changes.git add",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "Automatic binary config update\n\nGenerated by StarDoctor, see https://cr-buildbucket.appspot.com/build/0 for the recipe.\n\nBUG=None\nTEST=regenerated configs",
      "[CLEANUP]/commit_msg_tmp_3"
    ],
    "cwd": "[CLEANUP]/tmp_tmp_1",
    "infra_step": true,
    "name": "commit changes.write commit message",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@commit_msg_tmp_3@Automatic binary config update@@@",
      "@@@STEP_LOG_LINE@commit_msg_tmp_3@@@@",
      "@@@STEP_LOG_LINE@commit_msg_tmp_3@Generated by StarDoctor, see https://cr-buildbucket.appspot.com/build/0 for the recipe.@@@",
      "@@@STEP_LOG_LINE@commit_msg_tmp_3@@@@",
      "@@@STEP_LOG_LINE@commit_msg_tmp_3@BUG=None@@@",
      "@@@STEP_LOG_LINE@commit_msg_tmp_3@TEST=regenerated configs@@@",
      "@@@STEP_LOG_END@commit_msg_tmp_3@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "commit",
      "--file",
      "[CLEANUP]/commit_msg_tmp_3"
    ],
    "cwd": "[CLEANUP]/tmp_tmp_1",
    "infra_step": true,
    "name": "commit changes.git commit",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "commit changes.create gerrit change for [CLEANUP]/tmp_tmp_1",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LINK@link to change@https://chromium-review.googlesource.com/c/chromiumos/chromite/+/1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "[CLEANUP]/tmp_tmp_1",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV\\|$REPO_UPSTREAM"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace",
    "infra_step": true,
    "name": "commit changes.create gerrit change for [CLEANUP]/tmp_tmp_1.repo forall",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@raw_io.output@[CLEANUP]/tmp_tmp_1|src/[CLEANUP]/tmp_tmp_1|cros|refs/heads/master|refs/heads/master@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_REPO[depot_tools]/git_cl.py",
      "upload",
      "--bypass-hooks",
      "--force",
      "--reviewers",
      "dhanyaganesh@google.com",
      "--send-mail"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace/src/[CLEANUP]/tmp_tmp_1",
    "env_suffixes": {
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "commit changes.create gerrit change for [CLEANUP]/tmp_tmp_1.git_cl upload",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_REPO[depot_tools]/git_cl.py",
      "status",
      "--field",
      "url",
      "--fast"
    ],
    "cwd": "[START_DIR]/chromiumos_workspace/src/[CLEANUP]/tmp_tmp_1",
    "env_suffixes": {
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "commit changes.create gerrit change for [CLEANUP]/tmp_tmp_1.git_cl status",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "name": "$result"
  }
]