[
  {
    "cmd": [],
    "name": "cloudready specific setup"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CLEANUP]/chromiumos_workspace/src/browser"
    ],
    "infra_step": true,
    "name": "cloudready specific setup.create src/browser",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "wget",
      "https://s3.amazonaws.com/neverware-dev/.gclient"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/browser",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "cloudready specific setup.download cloudready .gclient file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CLEANUP]/chromiumos_workspace/src/browser/src"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/browser",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "cloudready specific setup.create src dir",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "clone",
      "--branch",
      "upstream/neverware-d90",
      "--single-branch",
      "https://chrome-internal.googlesource.com/external/gitlab.neverware.com/neverware/chromium-browser",
      ".",
      "-v",
      "--progress"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/browser/src",
    "env": {
      "GIT_HTTP_LOW_SPEED_LIMIT": "0"
    },
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "cloudready specific setup.git clone",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "cloudready specific setup.update deps file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "sed",
      "-i",
      "s#git@gitlab.neverware.com:neverware/#https://chrome-internal.googlesource.com/external/gitlab.neverware.com/neverware/#g",
      "src/tools/neverware/neverware_deps.conf"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/browser",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "cloudready specific setup.update deps file.replace git@gitlab.neverware.com:neverware/",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "sed",
      "-i",
      "s#git@github.com:neverware/#https://chrome-internal.googlesource.com/external/github.com/neverware/#g",
      "src/tools/neverware/neverware_deps.conf"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/browser",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "cloudready specific setup.update deps file.replace git@github.com:neverware/",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [],
    "name": "cloudready specific setup.modify update_deps.py",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "sed",
      "-i",
      "s#git#/usr/bin/git#g",
      "src/tools/neverware/update_deps.py"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/browser",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "cloudready specific setup.modify update_deps.py.use usr/bin/git",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "gclient",
      "sync"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/browser",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "cloudready specific setup.gclient sync",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]