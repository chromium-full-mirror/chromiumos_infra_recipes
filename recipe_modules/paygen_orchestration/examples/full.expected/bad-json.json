[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "/preload/chromeos-sdk"
    ],
    "infra_step": true,
    "name": "configure chroot path.create preload path",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get paygen json",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@paygen.json@{}@@@",
      "@@@STEP_LOG_END@paygen.json@@@"
    ]
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cat",
      "gs://chromeos-build-release-console/paygen.json"
    ],
    "infra_step": true,
    "name": "get paygen json.gsutil cat",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "failure": {
      "failure": {},
      "humanReason": "config json was not formatted correctly"
    },
    "name": "$result"
  }
]