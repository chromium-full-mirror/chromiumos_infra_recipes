[
  {
    "cmd": [],
    "name": "record logs",
    "~followup_annotations": [
      "@@@STEP_LINK@system_logs@https://pantheon.corp.google.com/storage/browser/chromeos-vmtest-archive//0/system_logs@@@"
    ]
  },
  {
    "cmd": [
      "sudo",
      "-n",
      "cp",
      "-rf",
      "/var/log",
      "[CLEANUP]/var-log-dump_tmp_1"
    ],
    "name": "record logs.copy logs",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "sudo",
      "-n",
      "chmod",
      "-R",
      "777",
      "[CLEANUP]/var-log-dump_tmp_1"
    ],
    "name": "record logs.loosen permission",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "record logs.GS upload system_logs",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LINK@archive_link@https://pantheon.corp.google.com/storage/browser/chromeos-vmtest-archive//0/system_logs@@@"
    ]
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "-o",
      "GSUtil:parallel_composite_upload_threshold=50M",
      "-m",
      "----",
      "rsync",
      "-r",
      "[CLEANUP]/var-log-dump_tmp_1",
      "gs://chromeos-vmtest-archive//0/system_logs"
    ],
    "infra_step": true,
    "name": "record logs.GS upload system_logs.gsutil rsync",
    "timeout": 120,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "name": "$result"
  }
]