[
  {
    "cmd": [],
    "name": "archive and upload test-results"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::archive]/resources/archive.py"
    ],
    "name": "archive and upload test-results.archive test results",
    "stdin": "{\"archive_type\": \"tgz\", \"entries\": [{\"path\": \"[CLEANUP]/test-results_tmp_1\", \"type\": \"dir\"}], \"output\": \"[CLEANUP]/archive_tmp_2/tast_results.tgz\", \"root\": \"[CLEANUP]/test-results_tmp_1\"}",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "-o",
      "GSUtil:parallel_composite_upload_threshold=50M",
      "-m",
      "----",
      "rsync",
      "[CLEANUP]/archive_tmp_2",
      "gs://chromeos-archive//0"
    ],
    "infra_step": true,
    "name": "archive and upload test-results.gsutil rsync",
    "timeout": 120,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "archive and upload test-results.set archive_link",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@SET_BUILD_PROPERTY@archive_link@\"gs://chromeos-archive//0\"@@@"
    ]
  },
  {
    "name": "$result"
  }
]