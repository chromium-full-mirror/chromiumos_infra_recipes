[
  {
    "cmd": [],
    "name": "upload test-results",
    "~followup_annotations": [
      "@@@STEP_LINK@tast-results@https://storage.cloud.google.com/chromeos-archive//0@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "-o",
      "GSUtil:parallel_composite_upload_threshold=50M",
      "-m",
      "----",
      "rsync",
      "-r",
      "[CLEANUP]/test-results_tmp_1",
      "gs://chromeos-archive//0"
    ],
    "infra_step": true,
    "name": "upload test-results.gsutil rsync",
    "timeout": 120,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "upload test-results.set archive_link",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@SET_BUILD_PROPERTY@archive_link@\"gs://chromeos-archive//0\"@@@"
    ]
  },
  {
    "name": "$result"
  }
]