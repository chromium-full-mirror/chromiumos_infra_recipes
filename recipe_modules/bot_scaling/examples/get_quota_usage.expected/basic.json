      "tasks/count?state=RUNNING&start=1336913601.5"
    ],
    "infra_step": true,
    "name": "get task query result",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
