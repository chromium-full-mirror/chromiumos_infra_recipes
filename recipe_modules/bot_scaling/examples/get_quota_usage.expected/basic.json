[
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::git]/resources/git_setup.py",
      "--path",
      "[CLEANUP]/swarming-client",
      "--url",
      "https://chromium.googlesource.com/infra/luci/client-py"
    ],
    "infra_step": true,
    "name": "git setup"
  },
  {
    "cmd": [
      "git",
      "fetch",
      "origin",
      "HEAD",
      "--progress"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "env": {
      "PATH": "RECIPE_REPO[depot_tools]:<PATH>"
    },
    "infra_step": true,
    "name": "git fetch"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "-f",
      "FETCH_HEAD"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "git checkout"
  },
  {
    "cmd": [
      "git",
      "rev-parse",
      "HEAD"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "read revision",
    "~followup_annotations": [
      "@@@STEP_TEXT@<br/>checked out 'deadbeef'<br/>@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "clean",
      "-f",
      "-d",
      "-x"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "git clean"
  },
  {
    "cmd": [
      "[CLEANUP]/swarming-client/swarming.py",
      "query",
      "--swarming",
      "chromeos-swarming.appspot.com",
      "bots/count?"
    ],
    "infra_step": true,
    "name": "get bot query result",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[CLEANUP]/swarming-client/swarming.py",
      "query",
      "--swarming",
