[
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/HEAD/bot_scaling/generated/bot_policy.binaryproto",
      "--format",
      "text"
    ],
    "name": "fetch HEAD:bot_scaling/generated/bot_policy.binaryproto",
    "timeout": 180
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::git]/resources/git_setup.py",
      "--path",
      "[CLEANUP]/swarming-client",
      "--url",
      "https://chromium.googlesource.com/infra/luci/client-py"
    ],
    "infra_step": true,
    "name": "git setup"
  },
  {
    "cmd": [
      "git",
      "fetch",
      "origin",
      "--progress"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "env": {
      "PATH": "RECIPE_REPO[depot_tools]:<PATH>"
    },
    "infra_step": true,
    "name": "git fetch"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "-f",
      "5d1ac84962602f74a9a83c5e0dbe594f8099db4b"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "git checkout"
  },
  {
    "cmd": [
      "git",
      "rev-parse",
      "HEAD"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "read revision",
    "~followup_annotations": [
      "@@@STEP_TEXT@<br/>checked out 'deadbeef'<br/>@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "clean",
      "-f",
      "-d",
