      "@@@STEP_LOG_LINE@json.output@  \"now\": \"2020-03-27T19:08:08.207587\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
