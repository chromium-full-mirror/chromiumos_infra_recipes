[
  {
    "cmd": [],
    "name": "ensure swarming bin from CIPD"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd",
      "-ensure-file",
      "infra/tools/luci/swarming/${platform} latest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure swarming bin from CIPD.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra/tools/luci/swarming/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/infradata/config/+/HEAD/configs/bot-scaling/generated/bot_policy_chromeos.binaryproto",
      "--format",
      "text"
    ],
    "name": "fetch HEAD:configs/bot-scaling/generated/bot_policy_chromeos.binaryproto",
    "timeout": 180
  },
  {
    "cmd": [],
    "name": "query swarming for cq"
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "bots",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-dimension",
      "role=cq",
      "-dimension",
      "bot_size=large"
    ],
    "infra_step": true,
    "name": "query swarming for cq.get bot count query result for cq",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"busy\": \"21\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"count\": \"23\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"dead\": \"0\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"maintenance\": \"0\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"now\": \"2020-03-26T23:38:02.383828\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"quarantined\": \"0\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-start",
      "1336913601.5",
      "-state",
      "RUNNING",
      "-tag",
      "role:cq",
      "-tag",
      "bot_size:large"
    ],
    "infra_step": true,
    "name": "query swarming for cq.get task count query result for cq",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"count\": \"23\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"now\": \"2020-03-27T19:08:08.207587\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-start",
      "1336913603.0",
      "-state",
      "PENDING",
      "-tag",
      "role:cq",
      "-tag",
      "bot_size:large"
    ],
    "infra_step": true,
    "name": "query swarming for cq.get task count query result for cq (2)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"count\": \"23\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"now\": \"2020-03-27T19:08:08.207587\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-start",
      "1336913604.5",
      "-state",
      "RUNNING",
      "-tag",
      "role:bar",
      "-tag",
      "bot_size:large"
    ],
    "infra_step": true,
    "name": "query swarming for cq.get task count query result for cq (3)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-start",
      "1336913606.0",
      "-state",
      "PENDING",
      "-tag",
      "role:bar",
      "-tag",
      "bot_size:large"
    ],
    "infra_step": true,
    "name": "query swarming for cq.get task count query result for cq (4)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]