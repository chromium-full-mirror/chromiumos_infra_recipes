[
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/bot_scaling/generated/bot_policy.binaryproto",
      "--format",
      "text"
    ],
    "name": "fetch master:bot_scaling/generated/bot_policy.binaryproto",
    "timeout": 180
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::git]/resources/git_setup.py",
      "--path",
      "[CLEANUP]/swarming-client",
      "--url",
      "https://chromium.googlesource.com/infra/luci/client-py"
    ],
    "infra_step": true,
    "name": "git setup"
  },
  {
    "cmd": [
      "git",
      "fetch",
      "origin",
      "master",
      "--progress"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "env": {
      "PATH": "RECIPE_REPO[depot_tools]:<PATH>"
    },
    "infra_step": true,
    "name": "git fetch"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "-f",
      "FETCH_HEAD"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "git checkout"
  },
  {
    "cmd": [
      "git",
      "rev-parse",
      "HEAD"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "read revision",
    "~followup_annotations": [
      "@@@STEP_TEXT@<br/>checked out 'deadbeef'<br/>@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "clean",
      "-f",
      "-d",
      "-x"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "git clean"
  },
  {
    "cmd": [
      "[CLEANUP]/swarming-client/swarming.py",
      "bots",
      "--swarming",
      "chromeos-swarming.appspot.com",
      "-b",
      "-d",
      "role",
      "cq",
      "-d",
      "bot_size",
      "large",
      "--idle"
    ],
    "infra_step": true,
    "name": "get bot query result"
  },
  {
    "cmd": [
      "[CLEANUP]/swarming-client/swarming.py",
      "bots",
      "--swarming",
      "chromeos-swarming.appspot.com",
      "-b",
      "-d",
      "role",
      "cq",
      "-d",
      "bot_size",
      "large",
      "--busy"
    ],
    "infra_step": true,
    "name": "get bot query result (2)"
  },
  {
    "cmd": [
      "[CLEANUP]/swarming-client/swarming.py",
      "bots",
      "--swarming",
      "chromeos-swarming.appspot.com",
      "-b",
      "-d",
      "role",
      "cq",
      "-d",
      "bot_size",
      "large",
      "--dead-only"
    ],
    "infra_step": true,
    "name": "get bot query result (3)"
  },
  {
    "name": "$result"
  }
]