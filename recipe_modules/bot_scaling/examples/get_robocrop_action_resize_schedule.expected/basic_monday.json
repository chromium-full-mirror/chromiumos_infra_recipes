      "--url",
      "https://chromium.googlesource.com/infra/luci/client-py"
    ],
    "infra_step": true,
    "name": "git setup"
  },
  {
    "cmd": [
      "git",
      "fetch",
      "origin",
      "--progress"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "env": {
      "PATH": "RECIPE_REPO[depot_tools]:<PATH>"
    },
    "infra_step": true,
    "name": "git fetch"
  },
  {
    "cmd": [
      "git",
      "checkout",
      "-f",
      "14cadf852292035c5dc145de47f8af1000c9897a"
    ],
    "cwd": "[CLEANUP]/swarming-client",
    "infra_step": true,
    "name": "git checkout"
  },
  {
