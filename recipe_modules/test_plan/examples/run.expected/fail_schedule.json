[
  {
    "cmd": [],
    "name": "run plan"
  },
  {
    "cmd": [],
    "name": "run plan.schedule",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "run plan.schedule.ensure skylab",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/skylab",
      "-ensure-file",
      "chromiumos/infra/skylab/${platform} prod",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "run plan.schedule.ensure skylab.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/skylab/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/skylab/skylab",
      "create-suite",
      "-pool",
      "ChromeOSSkylab",
      "-image",
      "image.bin",
      "-board",
      "build_target",
      "suite1"
    ],
    "name": "run plan.schedule.execute hw suite suite1",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "failure": {
      "failure": {
        "step": "run plan.schedule.execute hw suite suite1"
      },
      "humanReason": "Step('run plan.schedule.execute hw suite suite1') failed with return_code 1"
    },
    "name": "$result"
  }
]