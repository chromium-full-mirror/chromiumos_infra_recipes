      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/skylab/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/skylab/skylab",
      "create-suite",
      "-pool",
      "ChromeOSSkylab",
      "-image",
      "image.bin",
      "-board",
      "build_target",
      "suite1"
    ],
    "name": "run plan.schedule.execute hw suite suite1",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/skylab/skylab",
      "create-suite",
      "-pool",
      "ChromeOSSkylab",
      "-image",
      "image.bin",
      "-board",
      "build_target",
      "suite2"
    ],
    "name": "run plan.schedule.execute hw suite suite2",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [],
    "name": "run plan.collect",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "run plan.collect.ensure swarming",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[CACHE]/swarming_client",
