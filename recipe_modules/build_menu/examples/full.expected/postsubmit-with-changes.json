[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/cros_chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@builder config@id {@@@",
      "@@@STEP_LOG_LINE@builder config@  name: \"arm-generic-postsubmit\"@@@",
      "@@@STEP_LOG_LINE@builder config@  branch: \"master\"@@@",
      "@@@STEP_LOG_LINE@builder config@  type: POSTSUBMIT@@@",
      "@@@STEP_LOG_LINE@builder config@}@@@",
      "@@@STEP_LOG_LINE@builder config@general {@@@",
      "@@@STEP_LOG_LINE@builder config@  critical {@@@",
      "@@@STEP_LOG_LINE@builder config@  }@@@",
      "@@@STEP_LOG_LINE@builder config@  manifest: PUBLIC@@@",
      "@@@STEP_LOG_LINE@builder config@}@@@",
      "@@@STEP_LOG_LINE@builder config@build {@@@",
      "@@@STEP_LOG_LINE@builder config@  install_packages {@@@",
      "@@@STEP_LOG_LINE@builder config@    run_spec: RUN@@@",
      "@@@STEP_LOG_LINE@builder config@    dependencies: ALL_DEPENDENCIES@@@",
      "@@@STEP_LOG_LINE@builder config@  }@@@",
      "@@@STEP_LOG_LINE@builder config@}@@@",
      "@@@STEP_LOG_END@builder config@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.set recipes_git_revision",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@SET_BUILD_PROPERTY@recipes_git_revision@null@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.read builder configs",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "configure builder.read builder configs.fetch master:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "\nimport shutil\nimport sys\nshutil.copy(sys.argv[1], sys.argv[2])\n",
      "RECIPE_REPO[chromeos]/support/deploy_cipd.json",
      "/path/to/tmp/json"
    ],
    "name": "configure builder.read deploy_cipd.json",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"instance_id\": \"inst\", @@@",
      "@@@STEP_LOG_LINE@json.output@    \"package\": \"pkg\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cros-recipes-support",
      "-ensure-file",
      "pkg inst",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "name": "configure builder.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-inst------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"pkg\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cros-recipes-support/cipd-bin/gitiles-fetch-ref"
    ],
    "infra_step": true,
    "name": "configure builder.gitiles-fetch-ref",
    "stdin": "{\"branch\": {\"branch\": \"snapshot\", \"host\": \"chrome-internal.googlesource.com\", \"project\": \"chromeos/manifest-internal\"}}",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"branch\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"revision\": \"snapshot-HEAD-SHA\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gitiles_commit",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gitiles_commit.set gitiles_commit",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@SET_BUILD_PROPERTY@commit@{\"host\": \"chrome-internal.googlesource.com\", \"id\": \"snapshot-HEAD-SHA\", \"project\": \"chromeos/manifest-internal\", \"ref\": \"refs/heads/snapshot\"}@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gitiles_commit.set_output_gitiles_commit",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@SET_BUILD_PROPERTY@$recipe_engine/buildbucket/output_gitiles_commit@{\"host\": \"chrome-internal.googlesource.com\", \"id\": \"snapshot-HEAD-SHA\", \"project\": \"chromeos/manifest-internal\", \"ref\": \"refs/heads/snapshot\"}@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.build_manifest",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gerrit_changes",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.update src_state.gerrit_changes.set gerrit_changes",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@SET_BUILD_PROPERTY@changes@\"[]\"@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set build cost",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@build_cost@0.0002@@@"
    ]
  },
  {
    "failure": {
      "failure": {},
      "humanReason": "Changes provided, but builder does not apply changes"
    },
    "name": "$result"
  }
]