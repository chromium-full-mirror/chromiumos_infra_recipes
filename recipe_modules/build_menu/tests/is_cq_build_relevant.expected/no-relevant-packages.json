[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "/preload/chromeos-sdk"
    ],
    "infra_step": true,
    "name": "configure chroot path.create preload path",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "read builder configs"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/HEAD/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "read builder configs.fetch HEAD:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "check force relevance",
    "~followup_annotations": [
      "@@@STEP_TEXT@force relevant 0 target(s)@@@",
      "@@@STEP_LOG_LINE@found footer builders@found build(s): @@@",
      "@@@STEP_LOG_END@found footer builders@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get package dependencies"
  },
  {
    "cmd": [],
    "name": "get package dependencies.get affected paths",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get package dependencies.call chromite.api.DependencyService/List",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@request@{@@@",
      "@@@STEP_LOG_LINE@request@  \"chroot\": {@@@",
      "@@@STEP_LOG_LINE@request@    \"path\": \"[CACHE]/cros_chroot/chroot\"@@@",
      "@@@STEP_LOG_LINE@request@  }@@@",
      "@@@STEP_LOG_LINE@request@}@@@",
      "@@@STEP_LOG_END@request@@@",
      "@@@STEP_LOG_LINE@response@{\"package_deps\": []}@@@",
      "@@@STEP_LOG_END@response@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "{\n  \"chroot\": {\n    \"path\": \"[CACHE]/cros_chroot/chroot\"\n  }\n}",
      "[CLEANUP]/build_api_messages_tmp_1/input_proto.json"
    ],
    "infra_step": true,
    "name": "get package dependencies.call chromite.api.DependencyService/List.write input file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "[CLEANUP]/chromiumos_workspace/chromite/bin/build_api",
      "--input-json",
      "[CLEANUP]/build_api_messages_tmp_1/input_proto.json",
      "--output-json",
      "[CLEANUP]/build_api_messages_tmp_1/output_proto.json",
      "--log-level",
      "debug",
      "chromite.api.DependencyService/List"
    ],
    "env_suffixes": {
      "PATH": [
        "[CLEANUP]/chromiumos_workspace/chromite/bin"
      ]
    },
    "name": "get package dependencies.call chromite.api.DependencyService/List.call build API script",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/build_api_messages_tmp_1/output_proto.json",
      "/path/to/tmp/"
    ],
    "env_suffixes": {
      "PATH": [
        "[CLEANUP]/chromiumos_workspace/chromite/bin"
      ]
    },
    "infra_step": true,
    "name": "get package dependencies.call chromite.api.DependencyService/List.read output file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get package dependencies.call chromite.api.DependencyService/List.call response",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@build api stdout@@@@",
      "@@@STEP_LOG_END@build api stdout@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set exp_cq_relevance",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@exp_cq_relevance@false@@@"
    ]
  },
  {
    "name": "$result"
  }
]