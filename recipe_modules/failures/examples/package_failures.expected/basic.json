[
  {
    "cmd": [],
    "name": "installation results",
    "~followup_annotations": [
      "@@@STEP_TEXT@all packages installed successfully@@@"
    ]
  },
  {
    "cmd": [],
    "name": "installation failed: package",
    "~followup_annotations": [
      "@@@STEP_TEXT@failed to install /package@@@",
      "@@@STEP_LOG_LINE@list of failed packages@/package@@@",
      "@@@STEP_LOG_END@list of failed packages@@@",
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "cmd": [],
    "name": "installation failed: package1,package2",
    "~followup_annotations": [
      "@@@STEP_TEXT@failed to install 2 packages@@@",
      "@@@STEP_LOG_LINE@list of failed packages@/package1@@@",
      "@@@STEP_LOG_LINE@list of failed packages@/package2@@@",
      "@@@STEP_LOG_END@list of failed packages@@@",
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "name": "$result"
  }
]