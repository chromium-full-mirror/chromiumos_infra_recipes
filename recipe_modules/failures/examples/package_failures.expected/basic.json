[
  {
    "cmd": [],
    "name": "no failures"
  },
  {
    "cmd": [],
    "name": "one failure",
    "~followup_annotations": [
      "@@@STEP_TEXT@failed to install category/package-name@@@",
      "@@@STEP_LOG_LINE@list of failed packages@category/package-name@@@",
      "@@@STEP_LOG_END@list of failed packages@@@",
      "@@@STEP_LOG_LINE@category&#x2f;package-name log@test log@@@",
      "@@@STEP_LOG_END@category&#x2f;package-name log@@@",
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "cmd": [],
    "name": "multiple failures",
    "~followup_annotations": [
      "@@@STEP_TEXT@failed to install 2 packages: /package1, /package2@@@",
      "@@@STEP_LOG_LINE@list of failed packages@/package1@@@",
      "@@@STEP_LOG_LINE@list of failed packages@/package2@@@",
      "@@@STEP_LOG_END@list of failed packages@@@",
      "@@@STEP_LOG_LINE@&#x2f;package1 log@test log for package1@@@",
      "@@@STEP_LOG_END@&#x2f;package1 log@@@",
      "@@@STEP_LOG_LINE@&#x2f;package2 log@test log for package2@@@",
      "@@@STEP_LOG_END@&#x2f;package2 log@@@",
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "cmd": [],
    "name": "test3",
    "~followup_annotations": [
      "@@@STEP_TEXT@failed to install /package@@@",
      "@@@STEP_LOG_LINE@list of failed packages@/package@@@",
      "@@@STEP_LOG_END@list of failed packages@@@",
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "name": "$result"
  }
]