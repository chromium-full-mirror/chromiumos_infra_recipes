[
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "RECIPE_REPO[depot_tools]/.cipd_bin",
      "-ensure-file",
      "RECIPE_REPO[depot_tools]/cipd_manifest.txt",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "name": "ensure depot_tools/.cipd_bin",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {}@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "RECIPE_REPO[depot_tools]/git_cl.py",
      "upload",
      "--bypass-hooks",
      "--force",
      "--topic",
      "tensorflow",
      "--reviewers",
      "jeff@google.com",
      "--cc",
      "dean@google.com",
      "--hashtag",
      "foo-refactoring",
      "--hashtag",
      "bar-feature",
      "--send-mail",
      "--target-branch",
      "HEAD",
      "--cq-dry-run"
    ],
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "git_cl upload"
  },
  {
    "name": "$result"
  }
]