[
  {
    "cmd": [],
    "name": "ensure goma client"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/goma",
      "-ensure-file",
      "infra_internal/goma/client/${platform} latest",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure goma client.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra_internal/goma/client/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "process_goma_artifacts",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@NoGomaArtifacts@@@@",
      "@@@STEP_LOG_END@NoGomaArtifacts@@@"
    ]
  },
  {
    "cmd": [],
    "name": "process_goma_artifacts (2)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@gs_path@2012/05/14/build_target@@@",
      "@@@STEP_LOG_END@gs_path@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cp",
      "*.gz",
      "gs://chrome-goma-log/2012/05/14/build_target"
    ],
    "cwd": "[CLEANUP]/goma-logs-_tmp_1",
    "infra_step": true,
    "name": "process_goma_artifacts (2).gsutil upload",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LINK@gsutil.upload@https://storage.cloud.google.com/chrome-goma-log/2012/05/14/build_target@@@"
    ]
  },
  {
    "name": "$result"
  }
]