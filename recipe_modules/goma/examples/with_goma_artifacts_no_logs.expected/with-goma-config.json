[
  {
    "cmd": [],
    "name": "ensure goma client"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/goma",
      "-ensure-file",
      "infra_internal/goma/client/${platform} staging",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure goma client.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-staging---------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra_internal/goma/client/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "process_goma_artifacts",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@NoGomaArtifacts@@@@",
      "@@@STEP_LOG_END@NoGomaArtifacts@@@"
    ]
  },
  {
    "cmd": [],
    "name": "process_goma_artifacts (2)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@compile_event@stats {@@@",
      "@@@STEP_LOG_LINE@compile_event@  time_stats {@@@",
      "@@@STEP_LOG_LINE@compile_event@    uptime: 1234@@@",
      "@@@STEP_LOG_LINE@compile_event@  }@@@",
      "@@@STEP_LOG_LINE@compile_event@}@@@",
      "@@@STEP_LOG_LINE@compile_event@counterz_stats {@@@",
      "@@@STEP_LOG_LINE@compile_event@}@@@",
      "@@@STEP_LOG_END@compile_event@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/goma-logs-_tmp_1/stats.binaryproto",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "process_goma_artifacts (2).read_stats_proto",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/goma-logs-_tmp_1/counterz.binaryproto",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "process_goma_artifacts (2).read_counterz_proto",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "process_goma_artifacts (3)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@gs_bucket@chrome-goma-log@@@",
      "@@@STEP_LOG_END@gs_bucket@@@",
      "@@@STEP_LOG_LINE@gs_path@2012/05/14/build_target@@@",
      "@@@STEP_LOG_END@gs_path@@@",
      "@@@STEP_LOG_LINE@num_logs_uploaded@0@@@",
      "@@@STEP_LOG_END@num_logs_uploaded@@@"
