[
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "initial-recovery-version",
      "[CLEANUP]/test-version-file.txt"
    ],
    "infra_step": true,
    "name": "write version file",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@test-version-file.txt@initial-recovery-version@@@",
      "@@@STEP_LOG_END@test-version-file.txt@@@"
    ]
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cp",
      "[CLEANUP]/test-version-file.txt",
      "gs://test-gs-bucket/test-version-file.txt"
    ],
    "infra_step": true,
    "name": "gsutil upload test-version-file.txt",
    "~followup_annotations": [
      "@@@STEP_LINK@gsutil.upload@https://storage.cloud.google.com/test-gs-bucket/test-version-file.txt@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set test-version-file.txt",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@test-version-file.txt@\"initial-recovery-version\"@@@"
    ]
  },
  {
    "name": "$result"
  }
]