[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "/preload/chromeos-sdk"
    ],
    "infra_step": true,
    "name": "configure chroot path.create preload path",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "sync chrome"
  },
  {
    "cmd": [],
    "name": "sync chrome.sync chrome",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CLEANUP]/snapshot_chrome/src"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "infra_step": true,
    "name": "sync chrome.sync chrome.ensure chrome src directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CLEANUP]/snapshot_chrome/chrome_cache"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "infra_step": true,
    "name": "sync chrome.sync chrome.ensure chrome cache directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "RECIPE_REPO[depot_tools]/gclient.py",
      "config",
      "--spec",
      "solutions = [{\"custom_deps\": {}, \"custom_vars\": {\"checkout_src_internal\": true}, \"managed\": false, \"name\": \"src\", \"url\": \"https://chromium.googlesource.com/chromium/src.git\"}]\ncache_dir = '../chrome_cache'"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync chrome.sync chrome.gclient config",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "RECIPE_REPO[depot_tools]/git_cache.py",
      "populate",
      "-v",
      "--cache-dir",
      "../chrome_cache",
      "https://chromium.googlesource.com/chromium/src.git",
      "--reset-fetch-config"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync chrome.sync chrome.populate git cache",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "RECIPE_REPO[depot_tools]/gclient.py",
      "sync",
      "--reset",
      "--with_branch_heads",
      "--with_tags"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync chrome.sync chrome.gclient sync",
    "timeout": 3600,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "name": "$result"
  }
]