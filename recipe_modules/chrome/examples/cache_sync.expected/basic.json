[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [],
    "name": "sync chrome"
  },
  {
    "cmd": [],
    "name": "sync chrome.sync chrome",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0o777",
      "[CLEANUP]/snapshot_chrome/src"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "infra_step": true,
    "name": "sync chrome.sync chrome.ensure chrome src directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0o777",
      "[CLEANUP]/snapshot_chrome/chrome_cache"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "infra_step": true,
    "name": "sync chrome.sync chrome.ensure chrome cache directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_REPO[depot_tools]/gclient.py",
      "config",
      "--spec",
      "solutions = [\n    {\n        'url': 'https://chromium.googlesource.com/chromium/src.git',\n        'managed': False,\n        'name': 'src',\n        'custom_deps': {},\n        'custom_vars': {\n            'checkout_src_internal': True,\n            'checkout_google_internal': True\n        }\n    }\n]\ncache_dir = '../chrome_cache'"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]",
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync chrome.sync chrome.gclient config",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/git_cache.py",
      "populate",
      "-v",
      "--cache-dir",
      "../chrome_cache",
      "https://chromium.googlesource.com/chromium/src.git",
      "--reset-fetch-config"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync chrome.sync chrome.populate git cache",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_REPO[depot_tools]/gclient.py",
      "sync",
      "--reset",
      "--with_branch_heads",
      "--with_tags",
      "--verbose"
    ],
    "cwd": "[CLEANUP]/snapshot_chrome/src",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]",
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync chrome.sync chrome.gclient sync",
    "timeout": 10800,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "name": "$result"
  }
]