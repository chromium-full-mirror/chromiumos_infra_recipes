[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "curl",
      "-f",
      "https://gerrit.host.test/changes/12345/topic"
    ],
    "name": "curl https://gerrit.host.test/changes/12345/topic"
  },
  {
    "cmd": [],
    "name": "get CL 12345 description",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@description text@a quick description@@@",
      "@@@STEP_LOG_LINE@description text@@@@",
      "@@@STEP_LOG_LINE@description text@Change-Id: deadbeef@@@",
      "@@@STEP_LOG_END@description text@@@",
      "@@@STEP_LINK@gerrit change@https://gerrit.host.test/12345@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get CL 12345 description.ensure support CIPD package",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd-support",
      "-ensure-file",
      "chromiumos/infra/support/${platform} prod",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "get CL 12345 description.ensure support CIPD package.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/support/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
