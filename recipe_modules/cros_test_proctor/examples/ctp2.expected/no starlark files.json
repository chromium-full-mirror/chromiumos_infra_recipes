[
  {
    "cmd": [],
    "name": "run tests",
    "~followup_annotations": [
      "@@@STEP_TEXT@No starlark files found.@@@",
      "@@@STEP_EXCEPTION@@@"
    ]
  },
  {
    "cmd": [],
    "name": "run tests.schedule tests",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_EXCEPTION@@@"
    ]
  },
  {
    "cmd": [],
    "name": "run tests.schedule tests.find relevant plans",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [],
    "name": "run tests.schedule tests.find relevant plans.ensure test_plan",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd",
      "-ensure-file",
      "chromiumos/infra/test_plan/${platform} prod",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "run tests.schedule tests.find relevant plans.ensure test_plan.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@4@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_plan/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_plan",
      "relevant-plans",
      "-loglevel",
      "debug",
      "-cl",
      "https://chromium-review.googlesource.com/c/src/projectA/+/123/3",
      "-cl",
      "https://chromium-review.googlesource.com/c/src/projectB/+/456/7",
      "-out",
      "[CLEANUP]/test_plan_tmp_1"
    ],
    "infra_step": true,
    "name": "run tests.schedule tests.find relevant plans.call test_plan",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "listdir",
      "[CLEANUP]/test_plan_tmp_1"
    ],
    "infra_step": true,
    "name": "run tests.schedule tests.find relevant plans.list output files",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@STEP_LOG_END@listdir@@@"
    ]
  },
  {
    "name": "$result"
  }
