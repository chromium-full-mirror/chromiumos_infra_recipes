[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/cros_chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@builder config@id {@@@",
      "@@@STEP_LOG_LINE@builder config@  name: \"postsubmit-orchestrator\"@@@",
      "@@@STEP_LOG_LINE@builder config@  branch: \"master\"@@@",
      "@@@STEP_LOG_LINE@builder config@  type: POSTSUBMIT@@@",
      "@@@STEP_LOG_LINE@builder config@}@@@",
      "@@@STEP_LOG_LINE@builder config@general {@@@",
      "@@@STEP_LOG_LINE@builder config@  critical {@@@",
      "@@@STEP_LOG_LINE@builder config@    value: true@@@",
      "@@@STEP_LOG_LINE@builder config@  }@@@",
      "@@@STEP_LOG_LINE@builder config@}@@@",
      "@@@STEP_LOG_LINE@builder config@orchestrator {@@@",
      "@@@STEP_LOG_LINE@builder config@  child_specs {@@@",
      "@@@STEP_LOG_LINE@builder config@    name: \"amd64-generic-postsubmit\"@@@",
      "@@@STEP_LOG_LINE@builder config@  }@@@",
      "@@@STEP_LOG_LINE@builder config@  child_specs {@@@",
      "@@@STEP_LOG_LINE@builder config@    name: \"arm-generic-postsubmit\"@@@",
      "@@@STEP_LOG_LINE@builder config@  }@@@",
      "@@@STEP_LOG_LINE@builder config@}@@@",
      "@@@STEP_LOG_END@builder config@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.read builder configs",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "configure builder.read builder configs.fetch master:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [],
    "name": "configure builder.set builder_config",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@SET_BUILD_PROPERTY@builder_config@{\"general\": {\"critical\": true}, \"id\": {\"branch\": \"master\", \"name\": \"postsubmit-orchestrator\", \"type\": \"POSTSUBMIT\"}, \"orchestrator\": {\"childSpecs\": [{\"name\": \"amd64-generic-postsubmit\"}, {\"name\": \"arm-generic-postsubmit\"}]}}@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set BISECT_BUILDER",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@BISECT_BUILDER@\"bisecting-orchestrator\"@@@"
    ]
  },
  {
    "cmd": [],
    "name": "read builder configs"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "read builder configs.fetch master:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]