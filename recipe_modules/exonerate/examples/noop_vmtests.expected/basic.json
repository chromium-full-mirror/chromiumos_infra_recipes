[
  {
    "cmd": [],
    "name": "exonerate vm tests",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@exoneration logs@No tests were exonerated.@@@",
      "@@@STEP_LOG_END@exoneration logs@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/config-internal/+/main/test/exoneration/generated/test_exoneration.binaryproto",
      "--format",
      "text"
    ],
    "name": "exonerate vm tests.fetch main:test/exoneration/generated/test_exoneration.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]