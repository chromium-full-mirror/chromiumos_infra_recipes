[
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/config-internal/+/HEAD/test/exoneration/generated/test_exoneration.binaryproto",
      "--format",
      "text"
    ],
    "name": "fetch HEAD:test/exoneration/generated/test_exoneration.binaryproto",
    "timeout": 180
  },
  {
    "cmd": [],
    "name": "exonerate vm tests",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@exoneration logs@Exonerated arc.Boot on betty@@@",
      "@@@STEP_LOG_LINE@exoneration logs@Exonerated test2 on betty@@@",
      "@@@STEP_LOG_END@exoneration logs@@@",
      "@@@STEP_LOG_LINE@exonerated tests@arc.Boot:\t['betty']@@@",
      "@@@STEP_LOG_LINE@exonerated tests@test2:\t['betty']@@@",
      "@@@STEP_LOG_END@exonerated tests@@@"
    ]
  },
  {
    "cmd": [],
    "name": "exonerate vm tests (2)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@exoneration logs@No tests were exonerated.@@@",
      "@@@STEP_LOG_END@exoneration logs@@@"
    ]
  },
  {
    "cmd": [],
    "name": "exonerate vm tests (3)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@exoneration logs@No tests were exonerated.@@@",
      "@@@STEP_LOG_END@exoneration logs@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set exoneration_stats",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@exoneration_stats@{\"suiteCount\": \"1\", \"suiteStats\": [{\"count\": \"1\", \"name\": \"betty.tast_vm.tast_vm_default\"}], \"testCount\": \"2\", \"testStats\": [{\"count\": \"1\", \"name\": \"arc.Boot\"}, {\"count\": \"1\", \"name\": \"test2\"}, {\"count\": \"1\", \"name\": \"arc.Boot\"}, {\"count\": \"1\", \"name\": \"test2\"}]}@@@"
    ]
  },
  {
    "name": "$result"
  }
]