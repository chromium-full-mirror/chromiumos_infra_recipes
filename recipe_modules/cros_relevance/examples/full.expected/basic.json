[
  {
    "cmd": [],
    "name": "pointless build check",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@request@build_target {@@@",
      "@@@STEP_LOG_LINE@request@  name: \"my_build_target\"@@@",
      "@@@STEP_LOG_LINE@request@}@@@",
      "@@@STEP_LOG_LINE@request@output_path: \"/tmp/depgraph-my_build_target.json\"@@@",
      "@@@STEP_LOG_END@request@@@",
      "@@@STEP_LOG_LINE@response@build_dependency_graph_file: \"[START_DIR]/dir/for/depservice\"@@@",
      "@@@STEP_LOG_END@response@@@",
      "@@@STEP_LOG_LINE@relevance_output@buildIsPointless@@@",
      "@@@STEP_LOG_END@relevance_output@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "{\n  \"buildTarget\": {\n    \"name\": \"my_build_target\"\n  }, \n  \"outputPath\": \"/tmp/depgraph-my_build_target.json\"\n}",
      "[CLEANUP]/build_api_messages_tmp_1/input_proto.json"
    ],
    "infra_step": true,
    "name": "pointless build check.write input file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/chromiumos_workspace/chromite/bin/build_api",
      "--input-json",
      "[CLEANUP]/build_api_messages_tmp_1/input_proto.json",
      "--output-json",
      "[CLEANUP]/build_api_messages_tmp_1/output_proto.json",
      "chromite.api.DependencyService/GetBuildDependencyGraph"
    ],
    "env_suffixes": {
      "PATH": [
        "[START_DIR]/chromiumos_workspace/chromite/bin"
      ]
    },
    "name": "pointless build check.call build API: chromite.api.DependencyService/GetBuildDependencyGraph",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/build_api_messages_tmp_1/output_proto.json",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "pointless build check.read output file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "pointless build check.ensure pointless_build_checker",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/test_planner",
      "-ensure-file",
      "chromiumos/infra/test_planner latest",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "pointless build check.ensure pointless_build_checker.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_planner\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_planner/pointless_build_checker",
      "check-build",
      "--input_json",
      "{\"buildbucketProto\": {}, \"chromiumosWorkspaceCheckoutRoot\": \"[START_DIR]/chromiumos_master\", \"depGraphPath\": \"/mnt/host/source/[START_DIR]/dir/for/depservice\", \"repoToolPath\": \"RECIPE_REPO[depot_tools]/repo\"}",
      "--output_json",
      "/path/to/tmp/json"
    ],
    "name": "pointless build check.run check",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"buildIsPointless\": false@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "jsonResult": null,
    "name": "$result"
  }
]