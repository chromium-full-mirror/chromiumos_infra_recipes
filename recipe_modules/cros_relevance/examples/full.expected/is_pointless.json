[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/cros_chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "pointless build check",
    "~followup_annotations": [
      "@@@STEP_TEXT@build is unnecessary, exiting@@@",
      "@@@STEP_LOG_LINE@relevance_output@build_is_pointless {@@@",
      "@@@STEP_LOG_LINE@relevance_output@  value: true@@@",
      "@@@STEP_LOG_LINE@relevance_output@}@@@",
      "@@@STEP_LOG_END@relevance_output@@@",
      "@@@SET_BUILD_PROPERTY@pointless_build@true@@@"
    ]
  },
  {
    "cmd": [],
    "name": "pointless build check.ensure pointless_build_checker",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/test_planner",
      "-ensure-file",
      "chromiumos/infra/test_planner latest",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "pointless build check.ensure pointless_build_checker.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_planner\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_planner/pointless_build_checker",
      "check-build",
      "--input_json",
      "{\"buildbucketProto\": {}}",
      "--output_json",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "pointless build check.run check",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"buildIsPointless\": true@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "pointless build check (2)",
    "~followup_annotations": [
      "@@@STEP_TEXT@build is unnecessary, exiting@@@",
      "@@@STEP_LOG_LINE@relevance_output@build_is_pointless {@@@",
      "@@@STEP_LOG_LINE@relevance_output@  value: true@@@",
      "@@@STEP_LOG_LINE@relevance_output@}@@@",
      "@@@STEP_LOG_END@relevance_output@@@",
      "@@@SET_BUILD_PROPERTY@pointless_build@true@@@"
    ]
  },
  {
    "cmd": [],
    "name": "pointless build check (2).call chromite.api.DependencyService/GetBuildDependencyGraph",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@request@{@@@",
      "@@@STEP_LOG_LINE@request@  \"buildTarget\": {@@@",
      "@@@STEP_LOG_LINE@request@    \"name\": \"my_build_target\"@@@",
      "@@@STEP_LOG_LINE@request@  }@@@",
      "@@@STEP_LOG_LINE@request@}@@@",
      "@@@STEP_LOG_END@request@@@",
      "@@@STEP_LOG_LINE@stdout@@@@",
      "@@@STEP_LOG_END@stdout@@@",
      "@@@STEP_LOG_LINE@response@{\"dep_graph\": {\"package_deps\": [{\"dependency_source_paths\": [{\"path\": \"some/source/dir\"}]}]}}@@@",
      "@@@STEP_LOG_END@response@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "{\n  \"buildTarget\": {\n    \"name\": \"my_build_target\"\n  }\n}",
      "[CLEANUP]/build_api_messages_tmp_1/input_proto.json"
    ],
    "infra_step": true,
    "name": "pointless build check (2).call chromite.api.DependencyService/GetBuildDependencyGraph.write input file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/chromiumos_workspace/chromite/bin/build_api",
      "--input-json",
      "[CLEANUP]/build_api_messages_tmp_1/input_proto.json",
      "--output-json",
      "[CLEANUP]/build_api_messages_tmp_1/output_proto.json",
      "chromite.api.DependencyService/GetBuildDependencyGraph"
    ],
    "env_suffixes": {
      "PATH": [
        "[START_DIR]/chromiumos_workspace/chromite/bin"
      ]
    },
    "name": "pointless build check (2).call chromite.api.DependencyService/GetBuildDependencyGraph.call build API script",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/build_api_messages_tmp_1/output_proto.json",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "pointless build check (2).call chromite.api.DependencyService/GetBuildDependencyGraph.read output file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_planner/pointless_build_checker",
      "check-build",
      "--input_json",
      "{\"buildbucketProto\": {}, \"depGraph\": {\"packageDeps\": [{\"dependencySourcePaths\": [{\"path\": \"some/source/dir\"}]}]}}",
      "--output_json",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "pointless build check (2).run check",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"buildIsPointless\": true@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]