[
  {
    "cmd": [],
    "name": "plan builds",
    "~followup_annotations": [
      "@@@STEP_TEXT@will run 1 and skip 0 builds@@@",
      "@@@STEP_LOG_LINE@planner_output@builds_to_run {@@@",
      "@@@STEP_LOG_LINE@planner_output@  name: \"my little builder\"@@@",
      "@@@STEP_LOG_LINE@planner_output@}@@@",
      "@@@STEP_LOG_END@planner_output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "plan builds.ensure binaries",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/test_planner",
      "-ensure-file",
      "chromiumos/infra/test_planner latest",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "plan builds.ensure binaries.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_planner\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_planner/build_plan_generator",
      "generate-plan",
      "--input_json",
      "{\"builderConfigs\": [{\"general\": {\"runWhen\": {\"mode\": \"ALWAYS_RUN\"}}, \"id\": {\"name\": \"my little builder\"}}], \"gerritChanges\": [{\"serializedProto\": \"GHs=\"}, {\"serializedProto\": \"GMgD\"}], \"gitilesCommit\": {\"serializedProto\": \"GgVoZWxsbw==\"}, \"manifestCommit\": \"hello\"}",
      "--output_json",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "plan builds.run planner",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"buildsToRun\": [@@@",
      "@@@STEP_LOG_LINE@json.output@    {@@@",
      "@@@STEP_LOG_LINE@json.output@      \"name\": \"my little builder\"@@@",
      "@@@STEP_LOG_LINE@json.output@    }@@@",
      "@@@STEP_LOG_LINE@json.output@  ]@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]