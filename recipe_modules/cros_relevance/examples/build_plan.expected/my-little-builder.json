[
  {
    "cmd": [],
    "name": "plan builds",
    "~followup_annotations": [
      "@@@STEP_TEXT@1 relevant, 0 irrelevant builder configs@@@",
      "@@@STEP_LOG_LINE@planner_input@{@@@",
      "@@@STEP_LOG_LINE@planner_input@  \"builderConfigs\": [@@@",
      "@@@STEP_LOG_LINE@planner_input@    {@@@",
      "@@@STEP_LOG_LINE@planner_input@      \"id\": {@@@",
      "@@@STEP_LOG_LINE@planner_input@        \"name\": \"my little builder\"@@@",
      "@@@STEP_LOG_LINE@planner_input@      },@@@",
      "@@@STEP_LOG_LINE@planner_input@      \"general\": {@@@",
      "@@@STEP_LOG_LINE@planner_input@        \"runWhen\": {@@@",
      "@@@STEP_LOG_LINE@planner_input@          \"mode\": \"ALWAYS_RUN\"@@@",
      "@@@STEP_LOG_LINE@planner_input@        }@@@",
      "@@@STEP_LOG_LINE@planner_input@      }@@@",
      "@@@STEP_LOG_LINE@planner_input@    }@@@",
      "@@@STEP_LOG_LINE@planner_input@  ],@@@",
      "@@@STEP_LOG_LINE@planner_input@  \"gitilesCommit\": {@@@",
      "@@@STEP_LOG_LINE@planner_input@    \"serializedProto\": \"GgVoZWxsbw==\"@@@",
      "@@@STEP_LOG_LINE@planner_input@  }@@@",
      "@@@STEP_LOG_LINE@planner_input@}@@@",
      "@@@STEP_LOG_END@planner_input@@@",
      "@@@STEP_LOG_LINE@planner_output@builds_to_run {@@@",
      "@@@STEP_LOG_LINE@planner_output@  name: \"my little builder\"@@@",
      "@@@STEP_LOG_LINE@planner_output@}@@@",
      "@@@STEP_LOG_END@planner_output@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "\u001a\u001b\n\u0013\n\u0011my little builder\u0012\u0004\u001a\u0002\b\u0001\"\t\n\u0007\u001a\u0005hello",
      "[CLEANUP]/build-plan-_tmp_1/input.binaryproto"
    ],
    "infra_step": true,
    "name": "plan builds.write input binaryproto",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "plan builds.ensure build_plan_generator",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_TEXT@using legacy `prod` pin@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/build_plan_generator",
      "-ensure-file",
      "chromiumos/infra/build_plan_generator/${platform} prod",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "plan builds.ensure build_plan_generator.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/build_plan_generator/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/build_plan_generator/build_plan_generator",
      "generate-plan",
      "--input_binary_pb",
      "[CLEANUP]/build-plan-_tmp_1/input.binaryproto",
      "--output_binary_pb",
      "[CLEANUP]/build-plan-_tmp_1/output.binaryproto"
    ],
    "infra_step": true,
    "name": "plan builds.run planner",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/build-plan-_tmp_1/output.binaryproto",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "plan builds.read output file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]