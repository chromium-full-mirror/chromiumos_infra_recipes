[
  {
    "cmd": [],
    "name": "pointless build check"
  },
  {
    "cmd": [],
    "name": "pointless build check.depgraph relevance check",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_TEXT@no changes to check for relevancy@@@"
    ]
  },
  {
    "cmd": [],
    "name": "pointless build check.set properties",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_TEXT@build is irrelevant@@@",
      "@@@SET_BUILD_PROPERTY@pointless_build@true@@@",
      "@@@SET_BUILD_PROPERTY@relevant_build@false@@@"
    ]
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[recipe_engine::json]/resources/read.py",
      "RECIPE_REPO[chromeos]/support/deploy_cipd.json",
      "/path/to/tmp/json"
    ],
    "name": "read deploy_cipd.json",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"instance_id\": \"inst\", @@@",
      "@@@STEP_LOG_LINE@json.output@    \"package\": \"pkg\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cros-recipes-support",
      "-ensure-file",
      "pkg inst",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "name": "ensure_installed",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-inst------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"pkg\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cros-recipes-support/cipd-bin/gerrit-fetch-changes"
    ],
    "infra_step": true,
    "name": "gerrit-fetch-changes",
    "stdin": "{\"changes\": [], \"include_commit_info\": false, \"include_files\": false, \"include_messages\": false}",
    "timeout": 600,
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"changes\": []@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "cq build relevancy check"
  },
  {
    "name": "$result"
  }
]