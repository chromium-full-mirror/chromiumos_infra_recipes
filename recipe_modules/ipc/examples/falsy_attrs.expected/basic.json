[
  {
    "cmd": [],
    "name": "ensure ipcpubsub exists"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/ipcpubsub",
      "-ensure-file",
      "chromiumos/infra/ipcpubsub/${version} latest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure ipcpubsub exists.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/ipcpubsub/${version}\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/ipcpubsub/ipcpubsub",
      "publish",
      "-topic",
      "topic",
      "-file",
      "/dev/stdin",
      "-attributes",
      "{}"
    ],
    "infra_step": true,
    "name": "ipc_pubsub: publish",
    "stdin": "/path/to/message/file"
  },
  {
    "cmd": [
      "[START_DIR]/cipd/ipcpubsub/ipcpubsub",
      "subscribe",
      "-topic",
      "topic",
      "-sub-name",
      "subscription name",
      "-attributes",
      "{}"
    ],
    "infra_step": true,
    "name": "ipc_pubsub: subscribe"
  },
  {
    "name": "$result"
  }
]