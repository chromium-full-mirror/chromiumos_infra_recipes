[
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/prpc",
      "call",
      "-format",
      "json",
      "prpc.example.com",
      "my.pkg.Method"
    ],
    "name": "prpc my.pkg.Method",
    "stdin": "\"{\\n  \\\"id\\\": \\\"12345\\\"\\n}\"",
    "stdout": "/path/to/tmp/json",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@\"{\\n  \\\"id\\\": \\\"12345\\\"\\n}\"@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "jsonResult": null,
    "name": "$result"
  }
]