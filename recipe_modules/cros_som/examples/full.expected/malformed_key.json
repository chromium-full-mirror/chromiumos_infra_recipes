[
  {
    "cmd": [
      "luci-auth",
      "token",
      "-lifetime",
      "3m"
    ],
    "infra_step": true,
    "name": "get access token for default account"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::url]/resources/pycurl.py",
      "--url",
      "https://sheriff-o-matic.appspot.com/api/v1/annotations/chromeos",
      "--status-json",
      "/path/to/tmp/json",
      "--outfile",
      "/path/to/tmp/json",
      "--headers-json",
      "{\"Authorization\": \"Bearer extra.secret.token.should.not.be.logged\"}",
      "--transient-retry",
      "3"
    ],
    "name": "Get Sheriff-o-Matic annotations",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output[output]@[@@@",
      "@@@STEP_LOG_LINE@json.output[output]@  {@@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"KeyDigest\": \"1193804a7ba70acd455282bf518ee8136291f319\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"ModificationTime\": \"2019-06-14T22:15:09.958855Z\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"Tree\": \"ahFzfnNoZXJpZmYtby1tYXRpY3ISCxIEVHJlZSIIY2hyb21lb3MM\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"bug_data\": {}, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"bugs\": null, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"comments\": null, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"group_id\": \"b5da2ccf-ac62-446e-84bb-0b01b2a74317\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"key\": \"invalid_prefix:create sysroot|call chromite.api.SysrootService/Create|call build API script\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"snoozeTime\": 0@@@",
      "@@@STEP_LOG_LINE@json.output[output]@  }@@@",
      "@@@STEP_LOG_LINE@json.output[output]@]@@@",
      "@@@STEP_LOG_END@json.output[output]@@@"
    ]
  },
  {
    "failure": {
      "humanReason": "Got unexpected key: invalid_prefix:create sysroot|call chromite.api.SysrootService/Create|call build API script"
    },
    "name": "$result"
  }
]