[
  {
    "cmd": [
      "luci-auth",
      "token",
      "-lifetime",
      "3m"
    ],
    "infra_step": true,
    "name": "get access token for default account"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::url]/resources/pycurl.py",
      "--url",
      "https://sheriff-o-matic.appspot.com/api/v1/annotations/chromeos",
      "--status-json",
      "/path/to/tmp/json",
      "--outfile",
      "/path/to/tmp/json",
      "--headers-json",
      "{\"Authorization\": \"Bearer extra.secret.token.should.not.be.logged\"}",
      "--transient-retry",
      "3"
    ],
    "name": "get Sheriff-o-Matic annotations",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output[output]@[@@@",
      "@@@STEP_LOG_LINE@json.output[output]@  {@@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"bugs\": [@@@",
      "@@@STEP_LOG_LINE@json.output[output]@      \"1234\"@@@",
      "@@@STEP_LOG_LINE@json.output[output]@    ], @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"key\": \"chromeos.buildbucket:hw test results (3)|[FAILED] target.hw.bvt-cq\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"snoozeTime\": 0@@@",
      "@@@STEP_LOG_LINE@json.output[output]@  }, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@  {@@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"bugs\": null, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"key\": \"chromeos.buildbucket:vm test results (3)|[FAILED] target.vm.suite\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"snoozeTime\": 9999000000000@@@",
      "@@@STEP_LOG_LINE@json.output[output]@  }, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@  {@@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"bugs\": null, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"key\": \"chromeos.buildbucket:vm test results (3)|[FAILED] target.vm.suite (2)\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"snoozeTime\": 0@@@",
      "@@@STEP_LOG_LINE@json.output[output]@  }, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@  {@@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"bugs\": [@@@",
      "@@@STEP_LOG_LINE@json.output[output]@      \"780\"@@@",
      "@@@STEP_LOG_LINE@json.output[output]@    ], @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"key\": \"chromeos.buildbucket:build results (4)|[FAILED] ..\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"snoozeTime\": 0@@@",
      "@@@STEP_LOG_LINE@json.output[output]@  }, @@@",
      "@@@STEP_LOG_LINE@json.output[output]@  {@@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"group_id\": \"Hardware lab network outage\", @@@",
      "@@@STEP_LOG_LINE@json.output[output]@    \"key\": \"123\"@@@",
      "@@@STEP_LOG_LINE@json.output[output]@  }@@@",
      "@@@STEP_LOG_LINE@json.output[output]@]@@@",
      "@@@STEP_LOG_END@json.output[output]@@@"
    ]
  },
  {
    "name": "$result"
  }
]