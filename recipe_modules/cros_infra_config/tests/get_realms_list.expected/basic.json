[
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/HEAD/generated/realms.cfg",
      "--format",
      "text"
    ],
    "name": "fetch HEAD:generated/realms.cfg",
    "timeout": 180
  },
  {
    "name": "$result"
  }
]