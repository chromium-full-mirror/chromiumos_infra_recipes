      "@@@STEP_LOG_END@planner_input@@@",
      "@@@STEP_LOG_LINE@planner_output@builds_to_run {@@@",
      "@@@STEP_LOG_LINE@planner_output@  name: \"amd64-generic-postsubmit\"@@@",
      "@@@STEP_LOG_LINE@planner_output@  branch: \"master\"@@@",
      "@@@STEP_LOG_LINE@planner_output@  type: POSTSUBMIT@@@",
      "@@@STEP_LOG_LINE@planner_output@}@@@",
      "@@@STEP_LOG_LINE@planner_output@builds_to_run {@@@",
      "@@@STEP_LOG_LINE@planner_output@  name: \"arm-generic-postsubmit\"@@@",
      "@@@STEP_LOG_LINE@planner_output@  branch: \"master\"@@@",
      "@@@STEP_LOG_LINE@planner_output@  type: POSTSUBMIT@@@",
      "@@@STEP_LOG_LINE@planner_output@}@@@",
      "@@@STEP_LOG_END@planner_output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "plan builds.ensure binaries",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/test_planner",
      "-ensure-file",
      "chromiumos/infra/test_planner latest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "plan builds.ensure binaries.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_planner\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "\u001a\ufffd\u0001\n$\n\u0018amd64-generic-postsubmit\u0012\u0006master\u0018\u0002\u0012\u0004\n\u0002\b\u0001\"6\b\u0002\u001a\u0011chromeos-prebuilt\"\u0016chromeos-image-archiveB\u0007\n\u0005\u0012\u0003\n\u0001\u0001*\u0002\b\u00012/\n\u0011\n\u000fchrome_internal\u0012\u000f\n\rgeneric_buildz\u0004\n\u0002\u0001\u0003\ufffd\u0001\u0002\u0010\u0002:\u0002(\u0002\u001a/\n\"\n\u0016arm-generic-postsubmit\u0012\u0006master\u0018\u0002\u0012\u0002\n\u00002\u0005\ufffd\u0001\u0002\u0010\u0002\"\u0000",
      "[CLEANUP]/build-plan-_tmp_1/input.binaryproto"
    ],
    "infra_step": true,
    "name": "plan builds.write input binaryproto",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u001a\ufffd\u0001@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@$@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u0018amd64-generic-postsubmit\u0012\u0006master\u0018\u0002\u0012\u0004@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u0002\b\u0001\"6\b\u0002\u001a\u0011chromeos-prebuilt\"\u0016chromeos-image-archiveB\u0007@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u0005\u0012\u0003@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u0001\u0001*\u0002\b\u00012/@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u0011@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u000fchrome_internal\u0012\u000f@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@generic_buildz\u0004@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u0002\u0001\u0003\ufffd\u0001\u0002\u0010\u0002:\u0002(\u0002\u001a/@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\"@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u0016arm-generic-postsubmit\u0012\u0006master\u0018\u0002\u0012\u0002@@@",
      "@@@STEP_LOG_LINE@input.binaryproto@\u00002\u0005\ufffd\u0001\u0002\u0010\u0002\"\u0000@@@",
      "@@@STEP_LOG_END@input.binaryproto@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_planner/build_plan_generator",
      "generate-plan",
      "--input_binary_pb",
      "[CLEANUP]/build-plan-_tmp_1/input.binaryproto",
      "--output_binary_pb",
      "[CLEANUP]/build-plan-_tmp_1/output.binaryproto"
    ],
    "infra_step": true,
    "name": "plan builds.run planner",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/build-plan-_tmp_1/output.binaryproto",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "plan builds.read output file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get snapshot builds",
    "~followup_annotations": [
      "@@@STEP_TEXT@found 0 snapshot builds@@@"
    ]
  },
  {
    "cmd": [
      "bb",
      "ls",
      "-host",
      "cr-buildbucket.appspot.com",
      "-json",
      "-nopage",
      "-n",
      "2000",
      "-fields",
      "builder,create_time,created_by,critical,end_time,id,input,number,output,start_time,status,update_time",
      "-predicate",
      "{\"builder\": {\"bucket\": \"postsubmit\", \"project\": \"chromeos\"}, \"createTime\": {\"startTime\": \"2012-05-09T12:53:21Z\"}, \"tags\": [{\"key\": \"buildset\", \"value\": \"commit/gitiles///+/\"}]}"
    ],
    "infra_step": true,
    "name": "get snapshot builds.buildbucket.search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@"
    ]
  },
  {
    "cmd": [],
    "name": "filter builds",
    "~followup_annotations": [
      "@@@STEP_TEXT@need 2 new builds (filtered 0)@@@",
      "@@@STEP_LOG_LINE@filter log@from 0 -> 0 joinable after dedup and prioritization@@@",
      "@@@STEP_LOG_END@filter log@@@"
    ]
  },
  {
    "name": "$result"
  }
]