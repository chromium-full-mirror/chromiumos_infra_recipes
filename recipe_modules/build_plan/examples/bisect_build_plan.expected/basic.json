[
  {
    "cmd": [],
    "name": "read builder configs"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/master/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "name": "read builder configs.fetch master:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "plan builds",
    "~followup_annotations": [
      "@@@STEP_TEXT@2 relevant, 0 irrelevant builder configs@@@",
      "@@@STEP_LOG_LINE@planner_input@builder_configs {@@@",
      "@@@STEP_LOG_LINE@planner_input@  id {@@@",
      "@@@STEP_LOG_LINE@planner_input@    name: \"amd64-generic-postsubmit\"@@@",
      "@@@STEP_LOG_LINE@planner_input@    branch: \"master\"@@@",
      "@@@STEP_LOG_LINE@planner_input@    type: POSTSUBMIT@@@",
      "@@@STEP_LOG_LINE@planner_input@  }@@@",
      "@@@STEP_LOG_LINE@planner_input@  general {@@@",
      "@@@STEP_LOG_LINE@planner_input@    critical {@@@",
      "@@@STEP_LOG_LINE@planner_input@      value: true@@@",
      "@@@STEP_LOG_LINE@planner_input@    }@@@",
      "@@@STEP_LOG_LINE@planner_input@  }@@@",
      "@@@STEP_LOG_LINE@planner_input@  artifacts {@@@",
      "@@@STEP_LOG_LINE@planner_input@    prebuilts: PRIVATE@@@",
      "@@@STEP_LOG_LINE@planner_input@    prebuilts_gs_bucket: \"chromeos-prebuilt\"@@@",
      "@@@STEP_LOG_LINE@planner_input@    artifacts_gs_bucket: \"chromeos-image-archive\"@@@",
      "@@@STEP_LOG_LINE@planner_input@    artifacts_info {@@@",
      "@@@STEP_LOG_LINE@planner_input@      legacy {@@@",
      "@@@STEP_LOG_LINE@planner_input@        output_artifacts {@@@",
      "@@@STEP_LOG_LINE@planner_input@          artifact_types: IMAGE_ZIP@@@",
      "@@@STEP_LOG_LINE@planner_input@        }@@@",
      "@@@STEP_LOG_LINE@planner_input@      }@@@",
      "@@@STEP_LOG_LINE@planner_input@    }@@@",
      "@@@STEP_LOG_LINE@planner_input@  }@@@",
      "@@@STEP_LOG_LINE@planner_input@  chrome {@@@",
      "@@@STEP_LOG_LINE@planner_input@    internal: true@@@",
      "@@@STEP_LOG_LINE@planner_input@  }@@@",
      "@@@STEP_LOG_LINE@planner_input@  build {@@@",
      "@@@STEP_LOG_LINE@planner_input@    use_flags {@@@",
      "@@@STEP_LOG_LINE@planner_input@      flag: \"chrome_internal\"@@@",
      "@@@STEP_LOG_LINE@planner_input@    }@@@",
      "@@@STEP_LOG_LINE@planner_input@    portage_profile {@@@",
      "@@@STEP_LOG_LINE@planner_input@      profile: \"generic_build\"@@@",
      "@@@STEP_LOG_LINE@planner_input@    }@@@",
      "@@@STEP_LOG_LINE@planner_input@    build_images {@@@",
      "@@@STEP_LOG_LINE@planner_input@      image_types: BASE@@@",
      "@@@STEP_LOG_LINE@planner_input@      image_types: TEST@@@",
      "@@@STEP_LOG_LINE@planner_input@    }@@@",
      "@@@STEP_LOG_LINE@planner_input@    install_packages {@@@",
      "@@@STEP_LOG_LINE@planner_input@      run_spec: RUN@@@",
