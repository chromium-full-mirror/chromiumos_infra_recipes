[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [],
    "name": "read builder configs"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/infra/config/+/HEAD/generated/builder_configs.binaryproto",
      "--format",
      "text"
    ],
    "infra_step": true,
    "luci_context": {
      "realm": {
        "name": "chromeos:bisect"
      },
      "resultdb": {
        "current_invocation": {
          "name": "invocations/build:8945511751514863184",
          "update_token": "token"
        },
        "hostname": "rdbhost"
      }
    },
    "name": "read builder configs.fetch HEAD:generated/builder_configs.binaryproto",
    "timeout": 180,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "check force relevance",
    "~followup_annotations": [
      "@@@STEP_TEXT@force relevant 0 target(s)@@@",
      "@@@STEP_LOG_LINE@found footer builders@found build(s): @@@",
      "@@@STEP_LOG_END@found footer builders@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get snapshot builds",
    "~followup_annotations": [
      "@@@STEP_TEXT@found 0 snapshot builds@@@"
    ]
  },
  {
    "cmd": [
      "bb",
      "ls",
      "-host",
      "cr-buildbucket.appspot.com",
      "-json",
      "-nopage",
      "-n",
      "2000",
      "-fields",
      "builder,create_time,created_by,critical,end_time,id,infra,input,number,output,start_time,status,update_time",
      "-predicate",
      "{\"builder\": {\"bucket\": \"postsubmit\", \"project\": \"chromeos\"}, \"createTime\": {\"endTime\": \"2018-05-25T23:50:17Z\", \"startTime\": \"2012-05-09T12:53:23Z\"}, \"tags\": [{\"key\": \"buildset\", \"value\": \"commit/gitiles///+/\"}]}"
    ],
    "infra_step": true,
    "luci_context": {
      "realm": {
        "name": "chromeos:bisect"
      },
      "resultdb": {
        "current_invocation": {
          "name": "invocations/build:8945511751514863184",
          "update_token": "token"
        },
        "hostname": "rdbhost"
      }
    },
    "name": "get snapshot builds.buildbucket.search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@"
    ]
  },
  {
    "cmd": [],
    "name": "filter builds",
    "~followup_annotations": [
      "@@@STEP_TEXT@need 3 new builds (filtered 0)@@@",
      "@@@STEP_LOG_LINE@filter log@from 0 -> 0 joinable after dedup and prioritization@@@",
      "@@@STEP_LOG_END@filter log@@@"
    ]
  },
  {
    "cmd": [],
    "name": "filter builds.check should look for green",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@should_lfg@Found CQ looks experiment: False, Found LFG enabled: False, Found disallow footer: False. Using original snapshot.@@@",
      "@@@STEP_LOG_END@should_lfg@@@"
    ]
  },
  {
    "cmd": [],
    "name": "filter builds.check should look for green.check disallow looks for green",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@check disallow looks for green@Found Disallow-Looks-For-Green footers: []@@@",
      "@@@STEP_LOG_END@check disallow looks for green@@@"
    ]
  },
  {
    "cmd": [],
    "name": "filter builds.looks for green",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@cq looks log@CQ looks experiment not enabled. Using original snapshot.@@@",
      "@@@STEP_LOG_END@cq looks log@@@"
    ]
  },
  {
    "cmd": [],
    "name": "filter additional chrome pupr builds"
  },
  {
    "cmd": [],
    "name": "set properties",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@build_plan_new_build_requests@3@@@",
      "@@@SET_BUILD_PROPERTY@build_plan_skip_for_already_passed@0@@@",
      "@@@SET_BUILD_PROPERTY@build_plan_skip_for_noncritical_on_rerun@0@@@",
      "@@@SET_BUILD_PROPERTY@build_plan_skip_for_source_rules@0@@@",
      "@@@SET_BUILD_PROPERTY@build_plan_skip_for_wait_on_other_run@0@@@",
      "@@@SET_BUILD_PROPERTY@count_scheduled_slim_builds@0@@@",
      "@@@SET_BUILD_PROPERTY@count_skip_public_builders@0@@@",
      "@@@SET_BUILD_PROPERTY@slim_eligible_run@false@@@"
    ]
  },
  {
    "name": "$result"
  }
]