[
  {
    "cmd": [],
    "name": "ensure cros_test_runner"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/cros_test_runner",
      "-ensure-file",
      "chromiumos/infra/cros_test_runner/${platform} some-cipd-label",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure cros_test_runner.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-some-cipd-label-\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/cros_test_runner/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "call binary",
    "~followup_annotations": [
      "@@@STEP_EXCEPTION@@@"
    ]
  },
  {
    "cmd": [],
    "name": "callsite-execute-luciexe"
  },
  {
    "cmd": [],
    "name": "callsite-execute-luciexe.call binary",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@responses@{}@@@",
      "@@@STEP_LOG_END@responses@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "{}",
      "[START_DIR]/input.json"
    ],
    "infra_step": true,
    "name": "callsite-execute-luciexe.call binary.write input",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_END@input.json@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/cros_test_runner/cros_test_runner",
      "--output",
      "[CLEANUP]/tmp_tmp_1/sub_build.pb",
      "--",
      "-input_json",
      "[START_DIR]/input.json",
      "-output_json",
      "[START_DIR]/output.json"
    ],
    "env": {
      "MAC_CHROMIUM_TMPDIR": "[CLEANUP]/tmp_tmp_2",
      "TEMP": "[CLEANUP]/tmp_tmp_2",
      "TEMPDIR": "[CLEANUP]/tmp_tmp_2",
      "TMP": "[CLEANUP]/tmp_tmp_2",
      "TMPDIR": "[CLEANUP]/tmp_tmp_2"
    },
    "infra_step": true,
    "name": "callsite-execute-luciexe.call binary.launch luciexe",
    "stdin": "\u0012\u00002\u0006\b\ufffd\u00af\ufffd\u0005:\u0006\b\ufffd\u00af\ufffd\u0005`\u0002",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@step.sub_build@{@@@",
      "@@@STEP_LOG_LINE@step.sub_build@  \"status\": \"SUCCESS\"@@@",
      "@@@STEP_LOG_LINE@step.sub_build@}@@@",
      "@@@STEP_LOG_END@step.sub_build@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[START_DIR]/output.json",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "callsite-execute-luciexe.call binary.read output",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@output.json@@@@",
      "@@@STEP_LOG_END@output.json@@@"
    ]
  },
  {
    "name": "$result"
  }
]