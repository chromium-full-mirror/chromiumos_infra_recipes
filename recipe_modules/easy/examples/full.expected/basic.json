[
  {
    "cmd": [
      "cat"
    ],
    "name": "passthru"
  },
  {
    "cmd": [
      "gzip"
    ],
    "name": "raw",
    "stdin": "uncompressed"
  },
  {
    "cmd": [
      "jq"
    ],
    "name": "json",
    "stdin": "{\"a\": 1}",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"b\": 2@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]