      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0o777",
      "[CACHE]/cros_chroot/chroot"
    ],
    "infra_step": true,
    "name": "ensure chroot directory"
  },
  {
    "cmd": [],
