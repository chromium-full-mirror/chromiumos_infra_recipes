  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "remove",
      "[CLEANUP]/test/cros_chroot/sdk_cache_state.json"
    ],
    "infra_step": true,
    "name": "remove sdk version file"
  },
  {
    "cmd": [],
    "name": "clean up SDK chroot"
  },
  {
    "cmd": [],
    "name": "clean up SDK chroot.ensure no rogue SDK",
