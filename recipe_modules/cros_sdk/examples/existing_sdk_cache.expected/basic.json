      "@@@STEP_LOG_LINE@request@    \"path\": \"[CLEANUP]/test/cros_chroot/chroot\",@@@",
      "@@@STEP_LOG_LINE@request@    \"outPath\": \"[CLEANUP]/test/cros_chroot/out\"@@@",
      "@@@STEP_LOG_LINE@request@  }@@@",
      "@@@STEP_LOG_LINE@request@}@@@",
      "@@@STEP_LOG_END@request@@@",
      "@@@STEP_LOG_LINE@response@{}@@@",
      "@@@STEP_LOG_END@response@@@"
