[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [],
    "name": "is chroot usable",
    "~followup_annotations": [
      "@@@STEP_TEXT@not reusable: could not get external snapshot commit@@@",
      "@@@STEP_LOG_LINE@sdk cache version@Version in config: 1@@@",
      "@@@STEP_LOG_LINE@sdk cache version@Version on disk: 1@@@",
      "@@@STEP_LOG_END@sdk cache version@@@",
      "@@@STEP_LOG_LINE@sdk manifest url@Url in config: https://chrome-internal.googlesource.com/chromeos/manifest-internal@@@",
      "@@@STEP_LOG_LINE@sdk manifest url@Url on disk: https://chromium.googlesource.com/chromiumos/manifest@@@",
      "@@@STEP_LOG_END@sdk manifest url@@@",
      "@@@STEP_LOG_LINE@sdk manifest branch@Branch in config: @@@",
      "@@@STEP_LOG_LINE@sdk manifest branch@Branch on disk: snapshot@@@",
      "@@@STEP_LOG_END@sdk manifest branch@@@",
      "@@@STEP_LOG_LINE@sdk snapshot hash@Snapshot hash in config: @@@",
      "@@@STEP_LOG_LINE@sdk snapshot hash@Snapshot hash on disk: 123@@@",
      "@@@STEP_LOG_END@sdk snapshot hash@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CACHE]/cros_chroot/sdk_cache_state.json",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "is chroot usable.read sdk cache state json",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@sdk_cache_state.json@{@@@",
      "@@@STEP_LOG_LINE@sdk_cache_state.json@  \"manifest_branch\": \"snapshot\",@@@",
      "@@@STEP_LOG_LINE@sdk_cache_state.json@  \"manifest_url\": \"https://chromium.googlesource.com/chromiumos/manifest\",@@@",
      "@@@STEP_LOG_LINE@sdk_cache_state.json@  \"snapshot_hash\": \"123\\n\",@@@",
      "@@@STEP_LOG_LINE@sdk_cache_state.json@  \"version\": 1@@@",
      "@@@STEP_LOG_LINE@sdk_cache_state.json@}@@@",
      "@@@STEP_LOG_END@sdk_cache_state.json@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "remove",
      "[CACHE]/cros_chroot/sdk_cache_state.json"
    ],
    "infra_step": true,
    "name": "is chroot usable.remove sdk version file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "RECIPE_REPO[depot_tools]/git_footers.py",
      "",
      "--key",
      "Cr-External-Snapshot"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/manifest-internal",
    "infra_step": true,
    "name": "is chroot usable.read git footers",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]