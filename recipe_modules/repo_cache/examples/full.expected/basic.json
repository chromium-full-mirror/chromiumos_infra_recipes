[
  {
    "cmd": [],
    "name": "prepare repo cache"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[START_DIR]"
    ],
    "infra_step": true,
    "name": "prepare repo cache.cache dir",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "init",
      "--manifest-url",
      "https://example.com/manifest"
    ],
    "infra_step": true,
    "name": "prepare repo cache.repo init",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "sync",
      "--force-sync",
      "--detach",
      "--jobs",
      "32",
      "--no-tags",
      "--optimized-fetch"
    ],
    "infra_step": true,
    "name": "prepare repo cache.repo sync",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "jsonResult": null,
    "name": "$result"
  }
]