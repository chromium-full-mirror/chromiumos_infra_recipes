[
  {
    "cmd": [],
    "name": "ensure skylab"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/skylab",
      "-ensure-file",
      "chromiumos/infra/skylab/${platform} prod",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure skylab.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/skylab/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "test"
  },
  {
    "cmd": [
      "[START_DIR]/cipd/skylab/skylab",
      "create-suite",
      "-json",
      "-pool",
      "DUT_POOL_QUOTA",
      "-image",
      "path/to/artifact",
      "-board",
      "hard_wear_skylab-board",
      "-timeout-mins",
      "120",
      "suite1"
    ],
    "name": "test.suite1",
    "stdout": "/path/to/tmp/",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LINK@Skylab task UI: suite1@http://s.com/0@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/skylab/skylab",
      "create-suite",
      "-json",
      "-pool",
      "DUT_POOL_QUOTA",
      "-image",
      "path/to/artifact",
      "-board",
      "hard_wear_skylab-board",
      "-timeout-mins",
      "120",
      "suite2"
    ],
    "name": "test.suite2",
    "stdout": "/path/to/tmp/",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LINK@Skylab task UI: suite2@http://s.com/1@@@"
    ]
  },
  {
    "jsonResult": null,
    "name": "$result"
  }
]