[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "gcloud",
      "config",
      "set",
      "project",
      "chromeos-bot"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "set gcloud project"
  },
  {
    "cmd": [],
    "name": "source cache"
  },
  {
    "cmd": [],
    "name": "source cache.determine whether cache is mounted and can be reused",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache.setup source cache disk",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache.setup source cache disk.retrieve initial snapshot image from storage",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@snapshot_image@initial-chromiumos-source-snapshot@@@",
      "@@@STEP_LOG_END@snapshot_image@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache.setup source cache disk.create disk from snapshot image",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "images",
      "list",
      "--format",
      "json(name)",
      "--filter",
      "name=initial-chromiumos-source-snapshot",
      "--project",
      "chromeos-release-bot"
    ],
    "infra_step": true,
    "name": "source cache.setup source cache disk.create disk from snapshot image.check whether image exists: initial-chromiumos-source-snapshot",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@STEP_LOG_LINE@json.output@[@@@",
      "@@@STEP_LOG_LINE@json.output@  {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"name\": \"initial-chromiumos-source-snapshot\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@]@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache.setup source cache disk.create disk from snapshot image.set snapshot_version",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@SET_BUILD_PROPERTY@snapshot_version@\"initial-chromiumos-source-snapshot\"@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "disks",
      "describe",
      "chromeos-ci-infra-us-central1-b-x16-0-nvcj-cros",
      "--zone=us-central1-b",
      "--format",
      "json(name)"
    ],
    "infra_step": true,
    "name": "source cache.setup source cache disk.create disk from snapshot image.check whether disk exists: chromeos-ci-infra-us-central1-b-x16-0-nvcj-cros",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"name\": \"chromeos-ci-infra-us-central1-b-x16-0-nvcj-cros\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache.setup source cache disk.create disk from snapshot image.discarding mounted cache",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache.setup source cache disk.create disk from snapshot image.look up device name to device id map",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "detach-disk",
      "chromeos-ci-infra-us-central1-b-x16-0-nvcj",
      "--disk=chromeos-ci-infra-us-central1-b-x16-0-nvcj-cros",
      "--zone=us-central1-b",
      "--quiet"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "source cache.setup source cache disk.create disk from snapshot image.detach disk",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@STEP_TEXT@<br/>[WARNING: gcloud delete disk bookkeeping error for chromeos-ci-infra-us-central1-b-x16-0-nvcj-cros]@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "disks",
      "delete",
      "chromeos-ci-infra-us-central1-b-x16-0-nvcj-cros",
      "--zone=us-central1-b",
      "--quiet"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "source cache.setup source cache disk.create disk from snapshot image.delete disk",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "disks",
      "create",
      "chromeos-ci-infra-us-central1-b-x16-0-nvcj-cros",
      "--zone=us-central1-b",
      "--image-project=chromeos-release-bot",
      "--quiet",
      "--image=initial-chromiumos-source-snapshot",
      "--type=pd-ssd"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "source cache.setup source cache disk.create disk from snapshot image.create disk from image",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@"
    ]
  },
  {
    "cmd": [],
    "name": "source cache.look up device name to device id map",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "describe",
      "chromeos-ci-infra-us-central1-b-x16-0-nvcj",
      "--zone=us-central1-b",
      "--format=json(disks)"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "source cache.check GCE attached disks",
    "timeout": 60,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"disks\": [@@@",
      "@@@STEP_LOG_LINE@json.output@    {@@@",
      "@@@STEP_LOG_LINE@json.output@      \"deviceName\": \"cros\"@@@",
      "@@@STEP_LOG_LINE@json.output@    }@@@",
      "@@@STEP_LOG_LINE@json.output@  ]@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0o777",
      "[CLEANUP]/snapshot/chromiumos"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "source cache.create mount path",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "sudo",
      "mount",
      "-t",
      "ext4",
      "-o",
      "discard,defaults",
      "/dev/sdz",
      "[CLEANUP]/snapshot/chromiumos"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "source cache.mount disk cros",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "initial-chromiumos-source-snapshot",
      "[CACHE]/infra_versions/chromiumos-main-cache-snapshot-version.txt"
    ],
    "infra_step": true,
    "name": "source cache.write version file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@chromiumos-main-cache-snapshot-version.txt@initial-chromiumos-source-snapshot@@@",
      "@@@STEP_LOG_END@chromiumos-main-cache-snapshot-version.txt@@@"
    ]
  },
  {
    "name": "$result"
  }
]