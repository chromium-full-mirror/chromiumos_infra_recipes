[
  {
    "cmd": [
      "gcloud",
      "config",
      "set",
      "project",
      "chromeos-gce-tests"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "set gcloud project"
  },
  {
    "cmd": [
      "gcloud",
      "auth",
      "list"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "gcloud auth"
  },
  {
    "cmd": [],
    "name": "prepare image"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cp",
      "gs://chromeos-image-archive/image_path/image.zip",
      "[CLEANUP]/image-archive_tmp_1/image.zip"
    ],
    "infra_step": true,
    "name": "prepare image.gsutil download image bundle from GS",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[recipe_engine::archive]/resources/extract.py",
      "--json-input",
      "{\"archive_file\": \"[CLEANUP]/image-archive_tmp_1/image.zip\", \"include_files\": [\"chromiumos_test_image.bin\"], \"output\": \"[CLEANUP]/image-archive_tmp_1/image\", \"safe_mode\": true}",
      "--json-output",
      "/path/to/tmp/json"
    ],
    "name": "prepare image.unzip image bundle",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_TEXT@<br/>extracted 1337 files - 50159.75 MB@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"extracted\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"bytes\": 50159747054, @@@",
      "@@@STEP_LOG_LINE@json.output@    \"filecount\": 1337@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "move",
      "[CLEANUP]/image-archive_tmp_1/image/chromiumos_test_image.bin",
      "[CLEANUP]/image-archive_tmp_1/image/disk.raw"
    ],
    "infra_step": true,
    "name": "prepare image.Rename image to disk.raw",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "tar",
      "--format=oldgnu",
      "-Sczf",
      "1234.tar.gz",
      "disk.raw"
    ],
    "cwd": "[CLEANUP]/image-archive_tmp_1/image",
    "name": "prepare image.tar image",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "create image"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cp",
      "tar/path/1234.tar.gz",
      "gs://images-in-test/betty/1234.tar.gz"
    ],
    "infra_step": true,
    "name": "create image.gsutil upload",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LINK@gsutil.upload@https://storage.cloud.google.com/images-in-test/betty/1234.tar.gz@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "images",
      "create",
      "betty-1234",
      "--source-uri=gs://images-in-test/betty/1234.tar.gz"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "create image.gce create image",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "images",
      "delete",
      "image-name",
      "--quiet"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "delete image"
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "create",
      "image-name",
      "--image=image-name",
      "--project=chromeos-gce-tests",
      "--machine-type=n1-standard-4",
      "--no-scopes",
      "--no-address",
      "--zone=us-central1-b",
      "--network=chromeos-gce-tests",
      "--subnet=us-central1"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "create instance"
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "attach-disk",
      "image-name",
      "--disk=test-disk",
      "--zone=us-central1-b"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "attach disk"
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "disks",
      "snapshot",
      "test-disk",
      "--snapshot-names=test-disk-snapshot",
      "--zone=us-central1-b"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "snapshot disk"
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "detach-disk",
      "image-name",
      "--disk=test-disk",
      "--zone=us-central1-b"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "detach disk"
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "delete",
      "image-name",
      "--quiet",
      "--zone=us-central1-a",
      "--project=chromeos-gce-tests"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "name": "delete instance"
  },
  {
    "name": "$result"
  }
]