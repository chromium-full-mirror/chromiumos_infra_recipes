[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "/preload/chromeos-sdk"
    ],
    "infra_step": true,
    "name": "configure chroot path.create preload path",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get swarming hostname"
  },
  {
    "cmd": [],
    "name": "create and attach disk"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CACHE]/infra_versions/test-cache-main-cache-snapshot-version.txt",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "create and attach disk.read local snapshot version",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@test-cache-main-cache-snapshot-version.txt@test-cache-snapshot-123@@@",
      "@@@STEP_LOG_END@test-cache-main-cache-snapshot-version.txt@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "cat",
      "gs://chromeos-bot-cache/test-cache-main-cache-snapshot-version.txt"
    ],
    "infra_step": true,
    "name": "create and attach disk.gsutil cat",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "disks",
      "create",
      "test-cache-main-13370000-us-central1-b",
      "--zone=us-central1-b",
      "--source-snapshot=test-cache-snapshot-123"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "create and attach disk.create disk from snapshot",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "attach-disk",
      "chromeos-ci-infra-us-central1-b-x16-0-nvcj",
      "--disk=test-cache-main-13370000-us-central1-b",
      "--zone=us-central1-b"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "create and attach disk.attach disk",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "set-disk-auto-delete",
      "chromeos-ci-infra-us-central1-b-x16-0-nvcj",
      "--auto-delete",
      "--disk=test-cache-main-13370000-us-central1-b",
      "--zone=us-central1-b"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "create and attach disk.set disk to autodelete",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "mkdir",
      "-p",
      "/snapshot_mounts/test-cache"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "create and attach disk.ensure mount directory exists",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "sudo",
      "mount",
      "-o",
      "discard,defaults",
      "/dev/sdb",
      "/snapshot_mounts/test-cache"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "create and attach disk.mount disk test-cache",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "clean up mounted compute disk"
  },
  {
    "cmd": [
      "RECIPE_REPO[chromeos]/recipe_scripts/umount_path.sh",
      "/snapshot_mounts/test-cache"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "clean up mounted compute disk.unmount disk test-cache",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "clean up gce disk"
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "instances",
      "detach-disk",
      "chromeos-ci-infra-us-central1-b-x16-0-nvcj",
      "--disk=test-cache-main-13370000-us-central1-b",
      "--zone=us-central1-b"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "clean up gce disk.detach disk",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "gcloud",
      "compute",
      "disks",
      "delete",
      "test-cache-main-13370000-us-central1-b",
      "--zone=us-central1-b"
    ],
    "env": {
      "VIRTUAL_ENV": "1"
    },
    "infra_step": true,
    "name": "clean up gce disk.delete disk",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]