[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CACHE]/chroot/chroot"
    ],
    "infra_step": true,
    "name": "configure chroot path.ensure chroot directory",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/cros_sdk",
      "--nouse-image",
      "--chroot",
      "[CACHE]/chroot/chroot",
      "--",
      "portageq",
      "best_visible",
      ".",
      "chromeos-chrome"
    ],
    "name": "portageq best_visible chromeos-chrome",
    "stdout": "/path/to/tmp/",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@raw_io.output@a_malformed_package_string5@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "jsonResult": null,
    "name": "$result"
  }
]