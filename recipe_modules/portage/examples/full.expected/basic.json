[
  {
    "cmd": [],
    "name": "confgure chroot path"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[START_DIR]/cros_sdk/chroot"
    ],
    "infra_step": true,
    "name": "confgure chroot path.ensure chroot path",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "symlink",
      "[START_DIR]/cros_sdk/chroot",
      "[START_DIR]/chromiumos_workspace/chroot"
    ],
    "infra_step": true,
    "name": "confgure chroot path.link workspace checkout to chroot",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "symlink",
      "[START_DIR]/cros_sdk/chroot",
      "[START_DIR]/chromiumos_master/chroot"
    ],
    "infra_step": true,
    "name": "confgure chroot path.link master checkout to chroot",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/cros_sdk",
      "--nouse-image",
      "--chroot",
      "[START_DIR]/cros_sdk/chroot",
      "--",
      "egencache",
      "--update",
      "--repo",
      "my_overlay",
      "--jobs",
      "32"
    ],
    "name": "portage regen cache my_overlay"
  },
  {
    "cmd": [
      "vpython",
      "chromite/bin/cros_mark_as_stable",
      "commit",
      "--all",
      "--buildroot",
      "[START_DIR]/chromiumos_workspace",
      "--overlay-type",
      "both"
    ],
    "name": "uprev portage packages"
  },
  {
    "cmd": [
      "vpython",
      "chromite/bin/cros_mark_as_stable",
      "push",
      "--overlay-type",
      "both",
      "--dryrun"
    ],
    "name": "push portage package uprevs"
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/cros_sdk",
      "--nouse-image",
      "--chroot",
      "[START_DIR]/cros_sdk/chroot",
      "--",
      "portageq",
      "best_visible",
      ".",
      "chromeos-chrome"
    ],
    "name": "portageq best_visible chromeos-chrome",
    "stdout": "/path/to/tmp/",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@raw_io.output@chromeos-base/chromeos-chrome-74.0.3726.0_rc-r1@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "jsonResult": null,
    "name": "$result"
  }
]