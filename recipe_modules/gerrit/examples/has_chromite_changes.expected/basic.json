      "@@@STEP_LOG_LINE@json.output@      \"info\": {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"_number\": 91827, @@@",
      "@@@STEP_LOG_LINE@json.output@        \"branch\": \"main\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"change_id\": \"Ideadbeef\", @@@",
