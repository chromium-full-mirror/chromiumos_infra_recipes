[
  {
    "cmd": [],
    "name": "create gerrit change for project",
    "~followup_annotations": [
      "@@@STEP_LINK@gerrit change@https://host-review.googlesource.com/c/project/+/123@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "project",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV\\|$REPO_UPSTREAM"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "create gerrit change for project.repo forall",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@raw_io.output@project|src/project|cros|refs/heads/main|refs/heads/main@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_REPO[depot_tools]/git_cl.py",
      "upload",
      "--bypass-hooks",
      "--force",
      "--topic",
      "pupr",
      "--reviewers",
      "jeff",
      "--send-mail"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/project",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "create gerrit change for project.git_cl upload",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_REPO[depot_tools]/git_cl.py",
      "status",
      "--field",
      "url",
      "--fast"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/project",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "create gerrit change for project.git_cl status",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]