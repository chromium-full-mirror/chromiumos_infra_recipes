[
  {
    "cmd": [],
    "name": "check for merge conflicts",
    "~followup_annotations": [
      "@@@STEP_TEXT@unable to cherry-pick changes@@@",
      "@@@STEP_LOG_LINE@req@dict_items([('gerrit_changes', [{'host': 'chromium-review.googlesource.com', 'change_number': 91827, 'patch_set': 1}]), ('temp_dir', Path([CLEANUP], 'submittable_check')), ('reference_repos', {'chromeos/chromite': 'src/chromeos/chromite'})])@@@",
      "@@@STEP_LOG_END@req@@@",
      "@@@STEP_LOG_LINE@cherry-pick-failures@some cherry pick error line 1@@@",
      "@@@STEP_LOG_LINE@cherry-pick-failures@line2@@@",
      "@@@STEP_LOG_END@cherry-pick-failures@@@",
      "@@@SET_BUILD_PROPERTY@merge_conflict@true@@@",
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "-v",
      "--ignore-missing",
      "chromeos/chromite",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV\\|$REPO_UPSTREAM"
    ],
    "cwd": "[CACHE]/chromeos_root",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "check for merge conflicts.repo forall",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@raw_io.output_text@chromeos/chromite|src/chromeos/chromite|cros|refs/heads/main|refs/heads/main@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@"
    ]
  },
  {
    "cmd": [],
    "name": "check for merge conflicts.ensure support",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "RECIPE_REPO[chromeos]/infra/config/infrainfra-golang.version",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "check for merge conflicts.ensure support.read infrainfra golang version",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@infrainfra-golang.version@deadbeef@@@",
      "@@@STEP_LOG_END@infrainfra-golang.version@@@"
    ]
  },
  {
    "cmd": [],
    "name": "check for merge conflicts.ensure support.find cipd instance for support for infra/infra commit deadbeef",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@cipd instance@https://chrome-infra-packages.appspot.com/p/chromiumos/infra/support/${platform}/+/wzCA5zCcIkg0uYroNN91fpH1oQLMVHYaXM8RS9SuQwUC@@@",
      "@@@STEP_LOG_END@cipd instance@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "search",
      "chromiumos/infra/support/${platform}",
      "-tag",
      "git_revision:deadbeef",
      "-json-output",
      "[CLEANUP]/cipd.json"
    ],
    "infra_step": true,
    "name": "check for merge conflicts.ensure support.find cipd instance for support for infra/infra commit deadbeef.cipd search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/cipd.json",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "check for merge conflicts.ensure support.find cipd instance for support for infra/infra commit deadbeef.read [CLEANUP]/cipd.json",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@3@@@",
      "@@@STEP_LOG_LINE@cipd.json@{@@@",
      "@@@STEP_LOG_LINE@cipd.json@    \"result\": [@@@",
      "@@@STEP_LOG_LINE@cipd.json@        {@@@",
      "@@@STEP_LOG_LINE@cipd.json@            \"package\": \"chromiumos/infra/support/${platform}\",@@@",
      "@@@STEP_LOG_LINE@cipd.json@            \"instance_id\": \"wzCA5zCcIkg0uYroNN91fpH1oQLMVHYaXM8RS9SuQwUC\"@@@",
      "@@@STEP_LOG_LINE@cipd.json@        }@@@",
      "@@@STEP_LOG_LINE@cipd.json@    ]@@@",
      "@@@STEP_LOG_LINE@cipd.json@}@@@",
      "@@@STEP_LOG_END@cipd.json@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/support",
      "-ensure-file",
      "chromiumos/infra/support/${platform} wzCA5zCcIkg0uYroNN91fpH1oQLMVHYaXM8RS9SuQwUC",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "check for merge conflicts.ensure support.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-wzCA5zCcIkg0uYro\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/support/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/support/git-test-submit"
    ],
    "infra_step": true,
    "name": "check for merge conflicts.git-test-submit",
    "stdin": "{\"gerrit_changes\": [{\"change_number\": 91827, \"host\": \"chromium-review.googlesource.com\", \"patch_set\": 1}], \"reference_repos\": {\"chromeos/chromite\": \"src/chromeos/chromite\"}, \"temp_dir\": \"[CLEANUP]/submittable_check\"}",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"errors\": [@@@",
      "@@@STEP_LOG_LINE@json.output@    \"some cherry pick error line 1\\nline2\"@@@",
      "@@@STEP_LOG_LINE@json.output@  ]@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]