[
  {
    "cmd": [],
    "name": "ensure auth token"
  },
  {
    "cmd": [
      "luci-auth",
      "token",
      "-scopes",
      "https://www.googleapis.com/auth/gerritcodereview",
      "-json-output",
      "-"
    ],
    "name": "ensure auth token.Retrieve service_account auth token",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "Authorization: Bearer TEST_TOKEN",
      "[CLEANUP]/service_account_auth_token_tmp_1"
    ],
    "infra_step": true,
    "name": "ensure auth token.Write auth token to temp file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "curl",
      "-f",
      "-H",
      "@[CLEANUP]/service_account_auth_token_tmp_1",
      "https://mygithost.google.com/somerepo/changes/1/revisions/current/mergeable"
    ],
    "name": "curl https://mygithost.google.com/somerepo/changes/1/revisions/current/mergeable"
  },
  {
    "name": "$result"
  }
]