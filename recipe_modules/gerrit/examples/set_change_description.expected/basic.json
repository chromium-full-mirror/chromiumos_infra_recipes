      "@@@STEP_LOG_LINE@description text@my new desc@@@",
      "@@@STEP_LOG_END@description text@@@",
      "@@@STEP_LINK@link to change@https://chromium-review.googlesource.com/c/project/+/123@@@"
    ]
  },
  {
    "cmd": [
