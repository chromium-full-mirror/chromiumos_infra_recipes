[
  {
    "cmd": [],
    "name": "set CL 123 description",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@description text@my new desc@@@",
      "@@@STEP_LOG_END@description text@@@",
      "@@@STEP_LINK@gerrit change@https://chromium-review.googlesource.com/c/project/+/123@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "project",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV\\|$REPO_UPSTREAM"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "set CL 123 description.repo forall",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@raw_io.output@project|src/project|cros|refs/heads/main|refs/heads/main@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_REPO[depot_tools]/git_cl.py",
      "description",
      "-n",
      "-",
      "https://chromium-review.googlesource.com/c/project/+/123"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/project",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "name": "set CL 123 description.git_cl set description",
    "stdin": "my new desc\n",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "my new desc\n",
      "[CLEANUP]/commit_msg_tmp_1"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/project",
    "infra_step": true,
    "name": "set CL 123 description.write commit message",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@commit_msg_tmp_1@my new desc@@@",
      "@@@STEP_LOG_END@commit_msg_tmp_1@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "commit",
      "--amend",
      "--file",
      "[CLEANUP]/commit_msg_tmp_1"
    ],
    "cwd": "[CLEANUP]/chromiumos_workspace/src/project",
    "infra_step": true,
    "name": "set CL 123 description.git commit",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]