[
  {
    "cmd": [],
    "name": "call `build-parallels-image`"
  },
  {
    "cmd": [],
    "name": "call `build-parallels-image`.ensure build-parallels-image",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/build-parallels-image",
      "-ensure-file",
      "chromiumos/infra/build-parallels-image/${platform} prod",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "call `build-parallels-image`.ensure build-parallels-image.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/build-parallels-image/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/build-parallels-image/build-parallels-image",
      "provision",
      "--dut_name",
      "my-dut-name",
      "--image_gs_path",
      "gs://chromeos-image-archive/eve-release/R86-13380.0.0"
    ],
    "name": "call `build-parallels-image`.provision",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "call `build-parallels-image` (2)"
  },
  {
    "cmd": [
      "[START_DIR]/cipd/build-parallels-image/build-parallels-image",
      "provision",
      "--dut_name",
      "my-dut-name",
      "--image_gs_path",
      "gs://chromeos-image-archive/eve-release/R86-13381.0.0"
    ],
    "name": "call `build-parallels-image` (2).provision",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
