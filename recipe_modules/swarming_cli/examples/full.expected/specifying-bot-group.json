[
  {
    "cmd": [],
    "name": "ensure swarming bin from CIPD"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd",
      "-ensure-file",
      "infra/tools/luci/swarming/${platform} latest",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure swarming bin from CIPD.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-latest----------\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"infra/tools/luci/swarming/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "bots",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-dimension",
      "role=cq",
      "-dimension",
      "bot_size=large"
    ],
    "infra_step": true,
    "name": "get bot count query result for some-bot-group",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"busy\": \"21\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"count\": \"23\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"dead\": \"0\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"maintenance\": \"0\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"now\": \"2020-03-26T23:38:02.383828\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"quarantined\": \"0\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "bots",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-dimension",
      "role=foo",
      "-dimension",
      "bot_size=large"
    ],
    "infra_step": true,
    "name": "get bot count query result for some-bot-group (2)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-start",
      "1336827201.5",
      "-state",
      "RUNNING",
      "-tag",
      "role:cq",
      "-tag",
      "bot_size:large"
    ],
    "infra_step": true,
    "name": "get task count query result for some-bot-group",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"count\": \"23\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"now\": \"2020-03-27T19:08:08.207587\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-count",
      "-start",
      "1336827203.0",
      "-state",
      "PENDING",
      "-tag",
      "role:cq",
      "-tag",
      "bot_size:large"
    ],
    "infra_step": true,
    "name": "get task count query result for some-bot-group (2)",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"count\": \"23\",@@@",
      "@@@STEP_LOG_LINE@json.output@  \"now\": \"2020-03-27T19:08:08.207587\"@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/swarming",
      "tasks",
      "-S",
      "chromeos-swarming.appspot.com",
      "-start",
      "1336827204.5",
      "-state",
      "PENDING",
      "-tag",
      "role:cq",
      "-tag",
      "bot_size:large",
      "-limit",
      "1000"
    ],
    "infra_step": true,
    "name": "get task list query result",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@[@@@",
      "@@@STEP_LOG_LINE@json.output@  {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"created_ts\": \"2012-05-14T11:53:26.000000Z\"@@@",
      "@@@STEP_LOG_LINE@json.output@  },@@@",
      "@@@STEP_LOG_LINE@json.output@  {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"created_ts\": \"2012-05-14T10:53:26.000000Z\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@]@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]