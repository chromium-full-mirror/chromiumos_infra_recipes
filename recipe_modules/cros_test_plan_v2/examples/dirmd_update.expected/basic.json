[
  {
    "cmd": [],
    "name": "dirmd update"
  },
  {
    "cmd": [],
    "name": "dirmd update.ensure test_plan",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_TEXT@using legacy `prod` pin@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/test_plan",
      "-ensure-file",
      "chromiumos/infra/test_plan/${platform} prod",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "dirmd update.ensure test_plan.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_plan/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_plan/test_plan",
      "chromeos-dirmd-update",
      "-crossrcroot",
      "[CLEANUP]/chromiumos_workspace",
      "-table",
      "proj.dataset.mytable",
      "-loglevel",
      "debug"
    ],
    "infra_step": true,
    "name": "dirmd update.call test_plan",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]