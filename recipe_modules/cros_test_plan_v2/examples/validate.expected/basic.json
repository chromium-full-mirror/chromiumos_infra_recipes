[
  {
    "cmd": [],
    "name": "ensure test_plan"
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "RECIPE_REPO[chromeos]/infra/config/infrainfra-golang.version",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "ensure test_plan.read infrainfra golang version",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@infrainfra-golang.version@deadbeef@@@",
      "@@@STEP_LOG_END@infrainfra-golang.version@@@"
    ]
  },
  {
    "cmd": [],
    "name": "ensure test_plan.find cipd instance for test_plan for infra/infra commit deadbeef",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@cipd instance@https://chrome-infra-packages.appspot.com/p/chromiumos/infra/test_plan/${platform}/+/wzCA5zCcIkg0uYroNN91fpH1oQLMVHYaXM8RS9SuQwUC@@@",
      "@@@STEP_LOG_END@cipd instance@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "search",
      "chromiumos/infra/test_plan/${platform}",
      "-tag",
      "git_revision:deadbeef",
      "-json-output",
      "[CLEANUP]/cipd.json"
    ],
    "infra_step": true,
    "name": "ensure test_plan.find cipd instance for test_plan for infra/infra commit deadbeef.cipd search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/cipd.json",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "ensure test_plan.find cipd instance for test_plan for infra/infra commit deadbeef.read [CLEANUP]/cipd.json",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@cipd.json@{@@@",
      "@@@STEP_LOG_LINE@cipd.json@    \"result\": [@@@",
      "@@@STEP_LOG_LINE@cipd.json@        {@@@",
      "@@@STEP_LOG_LINE@cipd.json@            \"package\": \"chromiumos/infra/test_plan/${platform}\",@@@",
      "@@@STEP_LOG_LINE@cipd.json@            \"instance_id\": \"wzCA5zCcIkg0uYroNN91fpH1oQLMVHYaXM8RS9SuQwUC\"@@@",
      "@@@STEP_LOG_LINE@cipd.json@        }@@@",
      "@@@STEP_LOG_LINE@cipd.json@    ]@@@",
      "@@@STEP_LOG_LINE@cipd.json@}@@@",
      "@@@STEP_LOG_END@cipd.json@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd/test_plan",
      "-ensure-file",
      "chromiumos/infra/test_plan/${platform} wzCA5zCcIkg0uYroNN91fpH1oQLMVHYaXM8RS9SuQwUC",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure test_plan.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-wzCA5zCcIkg0uYro\",@@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/test_plan/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/test_plan/test_plan",
      "validate",
      "-loglevel",
      "debug",
      "[CLEANUP]/tmp_tmp_1"
    ],
    "name": "test_plan validate [CLEANUP]/tmp_tmp_1"
  },
  {
    "name": "$result"
  }
]