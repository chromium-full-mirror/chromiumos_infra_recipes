[
  {
    "cmd": [],
    "name": "validate properties"
  },
  {
    "cmd": [],
    "name": "fetch CIPD packages"
  },
  {
    "cmd": [],
    "name": "fetch CIPD packages.ensure upload_debug_symbols",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd",
      "-ensure-file",
      "chromiumos/infra/upload_debug_symbols/${platform} staging",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "fetch CIPD packages.ensure upload_debug_symbols.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-staging---------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/upload_debug_symbols/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "uploading",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@upload logs@@@@",
      "@@@STEP_LOG_END@upload logs@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/upload_debug_symbols",
      "upload",
      "-gs-path",
      "gs-test/debug_breakpad.tar.xz",
      "-worker-count 90",
      "-retry-quota 90",
      "-staging",
      "-dry-run=false"
    ],
    "name": "uploading.call upload go binary",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_END@raw_io.output_text[stdout]@@@"
    ]
  },
  {
    "name": "$result"
  }
]