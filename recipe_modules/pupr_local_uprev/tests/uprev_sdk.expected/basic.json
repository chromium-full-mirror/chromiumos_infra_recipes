[
  {
    "cmd": [],
    "name": "configure chroot path"
  },
  {
    "cmd": [],
    "name": "uprev sdk"
  },
  {
    "cmd": [],
    "name": "uprev sdk.validate SDK uprev spec",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "uprev sdk.call chromite.api.SdkService/Uprev",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@request@{@@@",
      "@@@STEP_LOG_LINE@request@  \"binhostGsBucket\": \"gs://chromeos-prebuilt/\",@@@",
      "@@@STEP_LOG_LINE@request@  \"version\": \"2023.03.14.159265\",@@@",
      "@@@STEP_LOG_LINE@request@  \"toolchainTarballTemplate\": \"2023/03/%(target)s-2023.03.14.159265.tar.xz\"@@@",
      "@@@STEP_LOG_LINE@request@}@@@",
      "@@@STEP_LOG_END@request@@@",
      "@@@STEP_LOG_LINE@response@{\"modified_files\": [{\"location\": 2, \"path\": \"[CLEANUP]/chromiumos_workspace/src/third_party/chromiumos-overlay/chromeos/binhost/host/sdk_version.conf\"}, {\"location\": 2, \"path\": \"[CLEANUP]/chromiumos_workspace/src/overlays/overlay-amd64-host/prebuilt.conf\"}], \"version\": \"2023.02.12.144623\"}@@@",
      "@@@STEP_LOG_END@response@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "{\n  \"binhostGsBucket\": \"gs://chromeos-prebuilt/\",\n  \"version\": \"2023.03.14.159265\",\n  \"toolchainTarballTemplate\": \"2023/03/%(target)s-2023.03.14.159265.tar.xz\"\n}",
      "[CLEANUP]/build_api_messages_tmp_1/input_proto.json"
    ],
    "infra_step": true,
    "name": "uprev sdk.call chromite.api.SdkService/Uprev.write input file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "[CLEANUP]/chromiumos_workspace/chromite/bin/build_api",
      "--input-json",
      "[CLEANUP]/build_api_messages_tmp_1/input_proto.json",
      "--output-json",
      "[CLEANUP]/build_api_messages_tmp_1/output_proto.json",
      "--log-level",
      "debug",
      "chromite.api.SdkService/Uprev"
    ],
    "env_suffixes": {
      "PATH": [
        "[CLEANUP]/chromiumos_workspace/chromite/bin"
      ]
    },
    "name": "uprev sdk.call chromite.api.SdkService/Uprev.call build API script",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/build_api_messages_tmp_1/output_proto.json",
      "/path/to/tmp/"
    ],
    "env_suffixes": {
      "PATH": [
        "[CLEANUP]/chromiumos_workspace/chromite/bin"
      ]
    },
    "infra_step": true,
    "name": "uprev sdk.call chromite.api.SdkService/Uprev.read output file",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [],
    "name": "uprev sdk.call chromite.api.SdkService/Uprev.call response",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@build api stdout@@@@",
      "@@@STEP_LOG_END@build api stdout@@@"
    ]
  },
  {
    "name": "$result"
  }
]