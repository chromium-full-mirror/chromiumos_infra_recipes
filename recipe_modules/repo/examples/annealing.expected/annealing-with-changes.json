      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--ignore-missing",
      "-j",
      "32",
      "-c",
      "git",
      "clean",
      "-d",
      "-f"
    ],
    "cwd": "[CLEANUP]/ensure",
    "infra_step": true,
    "name": "ensure synced checkout.ensure clean checkout.repo forall",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
