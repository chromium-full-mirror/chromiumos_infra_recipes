    "cwd": "[START_DIR]/repo/manifest-internal",
    "infra_step": true,
    "name": "sync manifests.repo manifest",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@raw_io.output@@@@",
      "@@@STEP_LOG_LINE@raw_io.output@    <manifest>@@@",
      "@@@STEP_LOG_LINE@raw_io.output@      <project name=\"NAME\" path=\"PATH\" revision=\"TO_REV\"/>@@@",
      "@@@STEP_LOG_LINE@raw_io.output@      <project name=\"NO_CHANGE\" revision=\"NO_CHANGE_REV\"/>@@@",
      "@@@STEP_LOG_LINE@raw_io.output@      <project name=\"IGNORE\" revision=\"TO_REV\">@@@",
      "@@@STEP_LOG_LINE@raw_io.output@        <annotation name=\"snapshot-mode\" value=\"ignore-diff\"/>@@@",
