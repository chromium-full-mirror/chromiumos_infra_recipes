      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--ignore-missing",
      "-j",
      "32",
      "-c",
      "find",
      ".",
      "-type",
      "f",
      "-path",
      "./.git/*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[CLEANUP]/ensure",
    "infra_step": true,
    "name": "ensure synced checkout.clear git locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
