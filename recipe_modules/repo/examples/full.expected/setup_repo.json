[
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "init",
      "--manifest-url",
      "http://manifest_url"
    ],
    "infra_step": true,
    "name": "repo init"
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "init",
      "--manifest-url",
      "http://manifest_url",
      "--manifest-branch",
      "mybranch",
      "--groups",
      "group1,group2",
      "--depth",
      "10",
      "--repo-url",
      "http://repo_url"
    ],
    "infra_step": true,
    "name": "repo init (2)"
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "sync"
    ],
    "infra_step": true,
    "name": "repo sync"
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "sync",
      "--force-sync",
      "--detach",
      "--current-branch",
      "--jobs",
      "99",
      "--manifest-name",
      "snapshot.xml",
      "--no-tags",
      "--optimized-fetch",
      "--cache-dir",
      "/tmp/cache"
    ],
    "infra_step": true,
    "name": "repo sync (2)"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "<manifest></manifest>",
      "[CLEANUP]/manifest_tmp_1"
    ],
    "infra_step": true,
    "name": "write manifest"
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "sync",
      "--manifest-name",
      "../../../[CLEANUP]/manifest_tmp_1"
    ],
    "infra_step": true,
    "name": "repo sync (3)"
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "forall",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV"
    ],
    "infra_step": true,
    "name": "repo forall",
    "stdout": "/path/to/tmp/",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@raw_io.output@a|src/a|cros|refs/heads/master@@@",
      "@@@STEP_LOG_LINE@raw_io.output@b|src/b|cros|refs/heads/master@@@",
      "@@@STEP_LOG_LINE@raw_io.output@c|src/c|cros|refs/heads/master@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "manifest",
      "-r"
    ],
    "infra_step": true,
    "name": "repo manifest",
    "stdout": "/path/to/tmp/",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@raw_io.output@<manifest></manifest>@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "cmd": [],
    "cwd": "[CLEANUP]",
    "name": "manifest diff",
    "~followup_annotations": [
      "@@@STEP_TEXT@manifest diff failed; no repo root found@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_PACKAGE_REPO[depot_tools]/repo",
      "diffmanifests",
      "../../../snapshot_a.xml",
      "../../../snapshot_b.xml"
    ],
    "cwd": "[START_DIR]/repo",
    "infra_step": true,
    "name": "manifest diff (2)"
  },
  {
    "cmd": [],
    "name": "diff remote and local manifest",
    "~followup_annotations": [
      "@@@STEP_TEXT@no manifest diffs from remote to local@@@",
      "@@@STEP_WARNINGS@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "fetch",
      "URL",
      "REV:"
    ],
    "infra_step": true,
    "name": "diff remote and local manifest.git fetch",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "rev-parse",
      "FETCH_HEAD"
    ],
    "infra_step": true,
    "name": "diff remote and local manifest.git rev-parse",
    "stdout": "/path/to/tmp/",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "git",
      "show",
      "FETCH_HEAD:snapshot.xml"
    ],
    "infra_step": true,
    "name": "diff remote and local manifest.git show",
    "stdout": "/path/to/tmp/",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "jsonResult": null,
    "name": "$result"
  }
]