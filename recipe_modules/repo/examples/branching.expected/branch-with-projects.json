[
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "",
      "[START_DIR]/repo/.repo/tmp_manifest"
    ],
    "cwd": "[START_DIR]/repo",
    "infra_step": true,
    "name": "write manifest",
    "~followup_annotations": [
      "@@@STEP_LOG_END@tmp_manifest@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "init",
      "--manifest-url",
      "",
      "--groups",
      "all",
      "--repo-rev=stable",
      "--manifest-name",
      "../tmp_manifest"
    ],
    "cwd": "[START_DIR]/repo",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "repo init",
    "timeout": 900
  },
  {
    "cmd": [],
    "name": "repo binary update"
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "version"
    ],
    "cwd": "[START_DIR]/repo",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "repo binary update.repo version",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "selfupdate"
    ],
    "cwd": "[START_DIR]/repo",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "repo binary update.repo selfupdate",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "version"
    ],
    "cwd": "[START_DIR]/repo",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "repo binary update.repo version (2)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "sync"
    ],
    "cwd": "[START_DIR]/repo",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "repo sync"
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "start",
      "with-projects",
      "project"
    ],
    "cwd": "[START_DIR]/repo",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "repo start"
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "abandon",
      "with-projects",
      "project"
    ],
    "cwd": "[START_DIR]/repo",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "repo abandon"
  },
  {
    "name": "$result"
  }
]