[
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--regex",
      "src/program/galaxy",
      "src/program/other",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV\\|$REPO_UPSTREAM"
    ],
    "infra_step": true,
    "name": "repo forall",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@raw_io.output@a|src/a|cros|refs/heads/master|refs/heads/master@@@",
      "@@@STEP_LOG_LINE@raw_io.output@b|src/b|cros|refs/heads/master|refs/heads/master@@@",
      "@@@STEP_LOG_LINE@raw_io.output@c|src/c|cros|refs/heads/master|refs/heads/master@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]