[
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--regex",
      "src/program/galaxy",
      "src/program/other",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV\\|$REPO_UPSTREAM"
    ],
    "infra_step": true,
    "name": "repo forall",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@raw_io.output@project-a|src/project-a|cros|refs/heads/master|refs/heads/master@@@",
      "@@@STEP_LOG_LINE@raw_io.output@project-b|src/project-b|cros|refs/heads/master|refs/heads/master@@@",
      "@@@STEP_LOG_LINE@raw_io.output@project-c|src/project-c|cros|refs/heads/master|refs/heads/master@@@",
      "@@@STEP_LOG_END@raw_io.output@@@"
    ]
  },
  {
    "name": "$result"
  }
]