[
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "[CLEANUP]/ensure/.recipes_state.json",
      "/path/to/tmp/json"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "infra_step": true,
    "name": "Read proto from [CLEANUP]/ensure/.recipes_state.json",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@.recipes_state.json@state: STATE_RECOVERY@@@",
      "@@@STEP_LOG_LINE@.recipes_state.json@manifest_url: \"http://manifest_url\"@@@",
      "@@@STEP_LOG_END@.recipes_state.json@@@"
    ]
  },
  {
    "cmd": [],
    "name": "set initial_repo_state",
    "~followup_annotations": [
      "@@@SET_BUILD_PROPERTY@initial_repo_state@{\"manifestUrl\": \"http://manifest_url\", \"state\": \"STATE_RECOVERY\"}@@@"
    ]
  },
  {
    "cmd": [],
    "name": "sync to snapshot"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "<manifest></manifest>",
      "[START_DIR]/repo/.repo/tmp_manifest"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "infra_step": true,
    "name": "sync to snapshot.write manifest",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@tmp_manifest@<manifest></manifest>@@@",
      "@@@STEP_LOG_END@tmp_manifest@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "init",
      "--manifest-url",
      "http://manifest_url",
      "--groups",
      "all",
      "--manifest-name",
      "../tmp_manifest",
      "--verbose"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync to snapshot.repo init",
    "timeout": 900,
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "sync to snapshot.repo binary update",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "version"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync to snapshot.repo binary update.repo version",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "selfupdate"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync to snapshot.repo binary update.repo selfupdate",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "version"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync to snapshot.repo binary update.repo version (2)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "find",
      ".repo/",
      "-type",
      "f",
      "-name",
      "*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "infra_step": true,
    "name": "sync to snapshot.clear repo locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--ignore-missing",
      "-j",
      "32",
      "-c",
      "find",
      ".",
      "-type",
      "f",
      "-path",
      "./.git/*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync to snapshot.clear git locks",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "sync",
      "--detach",
      "--optimized-fetch",
      "--retry-fetches",
      "8",
      "--verbose"
    ],
    "cwd": "[START_DIR]/repo/manifest-internal",
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "sync to snapshot.repo sync",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]