[
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "RECIPE_REPO[depot_tools]/.cipd_bin",
      "-ensure-file",
      "RECIPE_REPO[depot_tools]/cipd_manifest.txt",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "name": "ensure depot_tools/.cipd_bin",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {}@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--regex",
      "some/bad/regex",
      "-c",
      "echo $REPO_PROJECT\\|$REPO_PATH\\|$REPO_REMOTE\\|$REPO_RREV\\|$REPO_UPSTREAM"
    ],
    "env_suffixes": {
      "DEPOT_TOOLS_UPDATE": [
        "0"
      ],
      "PATH": [
        "RECIPE_REPO[depot_tools]"
      ]
    },
    "infra_step": true,
    "name": "repo forall",
    "~followup_annotations": [
      "@@@STEP_LOG_END@raw_io.output_text@@@"
    ]
  },
  {
    "name": "$result"
  }
]