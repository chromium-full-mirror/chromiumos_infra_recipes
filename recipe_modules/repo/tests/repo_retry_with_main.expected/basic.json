[
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "init",
      "--manifest-url",
      "https://chromium.googlesource.com/chromiumos/manifest",
      "--groups",
      "all"
    ],
    "cwd": "[CLEANUP]",
    "infra_step": true,
    "name": "repo init",
    "timeout": 900
  },
  {
    "cmd": [],
    "name": "repo binary update"
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "version"
    ],
    "cwd": "[CLEANUP]",
    "infra_step": true,
    "name": "repo binary update.repo version",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "selfupdate"
    ],
    "cwd": "[CLEANUP]",
    "infra_step": true,
    "name": "repo binary update.repo selfupdate",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "version"
    ],
    "cwd": "[CLEANUP]",
    "infra_step": true,
    "name": "repo binary update.repo version (2)",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "find",
      ".repo/",
      "-type",
      "f",
      "-name",
      "*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[CLEANUP]",
    "infra_step": true,
    "name": "clear repo locks"
  },
  {
    "cmd": [
      "RECIPE_REPO[depot_tools]/repo",
      "forall",
      "--ignore-missing",
      "-j",
      "32",
      "-c",
      "find",
      ".",
      "-type",
      "f",
      "-path",
      "./.git/*.lock",
      "-print",
      "-delete"
    ],
    "cwd": "[CLEANUP]",
    "infra_step": true,
    "name": "clear git locks"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0777",
      "[CLEANUP]/.repo/local_manifests"
    ],
    "cwd": "[CLEANUP]",
    "infra_step": true,
    "name": "ensure local manifest dir"
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/project/galaxy/milkyway/+/master/local_manifest.xml",
      "--format",
      "text"
    ],
    "cwd": "[CLEANUP]",
    "name": "fetch master:local_manifest.xml",
    "~followup_annotations": [
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "cmd": [
      "python",
      "-u",
      "RECIPE_MODULE[depot_tools::gitiles]/resources/gerrit_client.py",
      "--json-file",
      "/path/to/tmp/json",
      "--url",
      "https://chrome-internal.googlesource.com/chromeos/project/galaxy/milkyway/+/main/local_manifest.xml",
      "--format",
      "text"
    ],
    "cwd": "[CLEANUP]",
    "name": "fetch main:local_manifest.xml"
  },
  {
    "cmd": [
      "vpython",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "copy",
      "\n<manifest>\n  <remote name=\"cros-internal\"\n          fetch=\"https://chrome-internal.googlesource.com\"\n          review=\"https://chrome-internal-review.googlesource.com\" />\n  <project name=\"chromeos/private-repo1\"\n     path=\"src/private-repo1\"\n     remote=\"cros-internal\" />\n</manifest>\n    ",
      "[CLEANUP]/.repo/local_manifests/local_manifest.xml"
    ],
    "cwd": "[CLEANUP]",
    "infra_step": true,
    "name": "write local manifest",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@local_manifest.xml@@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@<manifest>@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@  <remote name=\"cros-internal\"@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@          fetch=\"https://chrome-internal.googlesource.com\"@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@          review=\"https://chrome-internal-review.googlesource.com\" />@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@  <project name=\"chromeos/private-repo1\"@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@     path=\"src/private-repo1\"@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@     remote=\"cros-internal\" />@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@</manifest>@@@",
      "@@@STEP_LOG_LINE@local_manifest.xml@    @@@",
      "@@@STEP_LOG_END@local_manifest.xml@@@"
    ]
  },
  {
    "name": "$result"
  }
]