[
  {
    "cmd": [],
    "name": "ensure support CIPD package"
  },
  {
    "cmd": [
      "cipd",
      "ensure",
      "-root",
      "[START_DIR]/cipd",
      "-ensure-file",
      "chromiumos/infra/support/${platform} prod",
      "-max-threads",
      "0",
      "-json-output",
      "/path/to/tmp/json"
    ],
    "infra_step": true,
    "name": "ensure support CIPD package.ensure_installed",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"result\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"\": [@@@",
      "@@@STEP_LOG_LINE@json.output@      {@@@",
      "@@@STEP_LOG_LINE@json.output@        \"instance_id\": \"resolved-instance_id-of-prod------------\", @@@",
      "@@@STEP_LOG_LINE@json.output@        \"package\": \"chromiumos/infra/support/resolved-platform\"@@@",
      "@@@STEP_LOG_LINE@json.output@      }@@@",
      "@@@STEP_LOG_LINE@json.output@    ]@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/gitiles-fetch-ref"
    ],
    "infra_step": true,
    "name": "gitiles-fetch-ref",
    "stdin": "{\"branch\": {\"branch\": \"main\", \"host\": \"testgerrit\", \"project\": \"my/project\"}}",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"branch\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"revision\": \"abcd1234\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [
      "[START_DIR]/cipd/gitiles-fetch-ref"
    ],
    "infra_step": true,
    "name": "gitiles-fetch-ref (2)",
    "stdin": "{\"branch\": {\"branch\": \"main\", \"host\": \"testgerrit\", \"project\": \"my/project\"}}",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@json.output@{@@@",
      "@@@STEP_LOG_LINE@json.output@  \"branch\": {@@@",
      "@@@STEP_LOG_LINE@json.output@    \"revision\": \"abcd1234\"@@@",
      "@@@STEP_LOG_LINE@json.output@  }@@@",
      "@@@STEP_LOG_LINE@json.output@}@@@",
      "@@@STEP_LOG_END@json.output@@@"
    ]
  },
  {
    "cmd": [],
    "name": "fetch gitiles file",
    "~followup_annotations": [
      "@@@STEP_LOG_LINE@data@{\"abc\":123}@@@",
      "@@@STEP_LOG_END@data@@@"
    ]
  },
  {
    "cmd": [
      "curl",
      "https://testgerrit/my/project/+/refs/heads/coolref/chromite/api/somefile.txt?format=TEXT"
    ],
    "name": "fetch gitiles file.curl https://testgerrit/my/project/+/refs/heads/coolref/chromite/api/somefile.txt?format=TEXT",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "fetch gitiles file (2)",
    "~followup_annotations": [
      "@@@STEP_FAILURE@@@"
    ]
  },
  {
    "cmd": [
      "curl",
      "https://testgerrit/my/project/+/refs/heads/coolref/chromite/api/somefile.txt?format=TEXT"
    ],
    "name": "fetch gitiles file (2).curl https://testgerrit/my/project/+/refs/heads/coolref/chromite/api/somefile.txt?format=TEXT",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "name": "$result"
  }
]