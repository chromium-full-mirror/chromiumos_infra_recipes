[
  {
    "cmd": [
      "vpython3",
      "-u",
      "RECIPE_MODULE[recipe_engine::file]/resources/fileutil.py",
      "--json-output",
      "/path/to/tmp/json",
      "ensure-directory",
      "--mode",
      "0o777",
      "[CACHE]/lvfs"
    ],
    "infra_step": true,
    "name": "ensure_local_cache"
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "----",
      "ls",
      "-r",
      "uri/*.cab"
    ],
    "infra_step": true,
    "name": "gsutil List files in uri"
  },
  {
    "cmd": [],
    "name": "fetch fwupd lvfs username"
  },
  {
    "cmd": [
      "vpython3",
      "RECIPE_MODULE[infra::secret_manager]/resources/cloud_secret_manager.py",
      "--project",
      "chromeos-bot",
      "--secret",
      "fwupd_lvfs_mirror_username",
      "--output",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "fetch fwupd lvfs username.get content from secret manager",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [],
    "name": "fetch fwupd lvfs username.fetch fwupd lvfs token",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "RECIPE_MODULE[infra::secret_manager]/resources/cloud_secret_manager.py",
      "--project",
      "chromeos-bot",
      "--secret",
      "fwupd_lvfs_mirror_token",
      "--output",
      "/path/to/tmp/"
    ],
    "infra_step": true,
    "name": "fetch fwupd lvfs username.fetch fwupd lvfs token.get content from secret manager",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@"
    ]
  },
  {
    "cmd": [
      "vpython3",
      "RECIPE_MODULE[chromeos::cros_lvfs_mirror]/resources/sync-pulp.py",
      "address",
      "[CACHE]/lvfs",
      "[CACHE]/gs.txt",
      "abcd1234:abcd1234"
    ],
    "name": "run sync-pulp.py"
  },
  {
    "cmd": [
      "python3",
      "-u",
      "RECIPE_MODULE[depot_tools::gsutil]/resources/gsutil_smart_retry.py",
      "--",
      "RECIPE_REPO[depot_tools]/gsutil.py",
      "-o",
      "GSUtil:parallel_composite_upload_threshold=50M",
      "-m",
      "----",
      "rsync",
      "-r",
      "-a",
      "public-read",
      "[CACHE]/lvfs",
      "uri"
    ],
    "infra_step": true,
    "name": "gsutil Sync to uri"
  },
  {
    "name": "$result"
  }
]