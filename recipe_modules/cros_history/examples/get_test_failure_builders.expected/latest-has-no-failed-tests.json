[
  {
    "cmd": [],
    "name": "find matching builds"
  },
  {
    "cmd": [
      "bb",
      "ls",
      "-host",
      "cr-buildbucket.appspot.com",
      "-json",
      "-nopage",
      "-n",
      "1000",
      "-fields",
      "builder,create_time,created_by,critical,end_time,id,input,number,output,start_time,status,update_time",
      "-predicate",
      "{\"builder\": {}, \"createTime\": {\"endTime\": \"1970-01-01T00:00:00Z\", \"startTime\": \"2012-05-09T12:53:21Z\"}}"
    ],
    "infra_step": true,
    "name": "find matching builds.buildbucket.search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@",
      "@@@STEP_LOG_LINE@raw_io.output_text@{\"input\": {\"gerritChanges\": [{\"change\": \"1234\"}]}, \"builder\": {\"builder\": \"atlas-cq\"}, \"id\": \"2\", \"startTime\": \"1970-01-01T03:25:45Z\", \"output\": {\"properties\": {\"test_failures\": {\"hw_test_failures\": [{\"test_spec\": \"{\\n  \\\"common\\\": {\\n    \\\"builderName\\\": \\\"my-little-builder\\\"\\n  }\\n}\"}, {\"test_spec\": \"{\\n  \\\"common\\\": {\\n    \\\"builderName\\\": \\\"your-little-builder\\\"\\n  }\\n}\"}], \"needs_bisection\": false}}}}@@@",
      "@@@STEP_LOG_LINE@raw_io.output_text@{\"input\": {\"gerritChanges\": [{\"change\": \"1234\"}]}, \"builder\": {\"builder\": \"atlas-cq\"}, \"id\": \"1\", \"startTime\": \"1970-01-01T03:25:46Z\", \"output\": {\"properties\": {\"test_failures\": {\"hw_test_failures\": [], \"needs_bisection\": false}}}}@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@",
      "@@@STEP_LINK@atlas-cq@https://cr-buildbucket.appspot.com/build/1@@@"
    ]
  },
  {
    "name": "$result"
  }
]