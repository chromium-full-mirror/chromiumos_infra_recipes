    "cmd": [],
    "name": "get change test history",
    "~followup_annotations": [
      "@@@STEP_TEXT@some tests already passed@@@",
      "@@@STEP_LOG_LINE@list of passed tests@nami/hw/bvt-cq@@@",
      "@@@STEP_LOG_END@list of passed tests@@@"
    ]
  },
  {
    "cmd": [],
    "name": "get change test history.find matching builds",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@1@@@"
    ]
  },
  {
    "cmd": [
      "bb",
      "ls",
      "-host",
      "cr-buildbucket.appspot.com",
      "-json",
      "-nopage",
      "-n",
      "1000",
      "-fields",
      "builder,create_time,created_by,critical,end_time,id,input,number,output,start_time,status,update_time",
      "-predicate",
      "{\"builder\": {}, \"createTime\": {\"startTime\": \"2012-05-09T12:53:21Z\"}}"
    ],
    "infra_step": true,
    "name": "get change test history.find matching builds.buildbucket.search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@raw_io.output_text@{\"input\": {\"gerritChanges\": [{\"change\": \"1234\"}]}, \"builder\": {\"builder\": \"atlas-cq\"}, \"id\": \"123\", \"output\": {\"properties\": {\"passed_tests\": [\"nami/hw/bvt-cq\"]}}}@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@",
      "@@@STEP_LINK@atlas-cq@https://cr-buildbucket.appspot.com/build/123@@@"
    ]
  },
  {
    "name": "$result"
  }
