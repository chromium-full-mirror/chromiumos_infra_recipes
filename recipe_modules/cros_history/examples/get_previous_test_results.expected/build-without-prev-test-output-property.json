      "{\"builder\": {}, \"createTime\": {\"endTime\": \"1970-01-01T00:00:00Z\", \"startTime\": \"2012-05-09T12:53:23Z\"}}"
    ],
    "infra_step": true,
    "name": "get previous test results.find matching builds.buildbucket.search",
    "~followup_annotations": [
      "@@@STEP_NEST_LEVEL@2@@@",
      "@@@STEP_LOG_LINE@raw_io.output_text@{\"builder\": {\"builder\": \"cq-orchestrator\"}, \"createTime\": \"2019-07-07T04:54:00Z\", \"endTime\": \"2019-07-07T04:54:02Z\", \"id\": \"123\", \"input\": {\"gerritChanges\": [{\"change\": \"1234\"}]}, \"output\": {\"properties\": {\"test_summary\": {\"critical\": true, \"name\": \"test-builder.type.suite\", \"status\": \"FAILURE\"}}}, \"startTime\": \"2019-07-07T04:54:01Z\", \"status\": \"FAILURE\"}@@@",
      "@@@STEP_LOG_END@raw_io.output_text@@@",
      "@@@STEP_LINK@cq-orchestrator@https://cr-buildbucket.appspot.com/build/123@@@"
